<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Register — TennisTrack</title>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <div class="logo-circle">🎾</div>
      <h1>Create account</h1>
      <p>Start tracking your tennis journey</p>
    </div>
    <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form method="POST" action="/register">
      <div class="form-group">
        <label class="form-label">Full name</label>
        <input class="form-input" name="full_name" type="text" placeholder="Rafael Nadal" autofocus/>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Username</label>
          <input class="form-input" name="username" type="text" placeholder="rnadal" required/>
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input class="form-input" name="email" type="email" placeholder="you@example.com" required/>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Phone <span style="font-size:11px;color:#9ca3af;font-weight:400;">optional · for match reminders</span></label>
        <input class="form-input" name="phone" type="tel" placeholder="+1 555 000 0000"/>
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input class="form-input" name="password" type="password" placeholder="Min 6 characters" required minlength="6"/>
      </div>
      <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:10px 14px;margin:10px 0;font-size:12px;color:#166534;display:flex;gap:8px;align-items:center;">
        <span>📧</span>
        <span>We'll send a verification link to your email to activate your account.</span>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;">Create account</button>
    </form>
    <p style="text-align:center;margin-top:20px;font-size:13px;color:#6b7280;">
      Already have an account? <a href="/login" style="color:#16a34a;font-weight:500;">Sign in</a>
    </p>
  </div>
</div>
</body>
</html>
