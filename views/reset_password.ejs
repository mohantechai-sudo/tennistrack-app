<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Reset Password — TennisTrack</title>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <div class="logo-circle">🎾</div>
      <h1>TennisTrack</h1>
      <p>Choose a new password</p>
    </div>
    <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
    <p style="text-align:center;margin-top:16px;">
      <a href="/login" class="btn btn-primary" style="display:inline-block;">Sign in</a>
    </p>
    <% } else if (token) { %>
    <form method="POST" action="/reset-password/<%= token %>">
      <div class="form-group">
        <label class="form-label">New password</label>
        <input class="form-input" name="password" type="password" placeholder="At least 6 characters" required autofocus minlength="6"/>
      </div>
      <div class="form-group">
        <label class="form-label">Confirm new password</label>
        <input class="form-input" name="confirm" type="password" placeholder="Repeat password" required minlength="6"/>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;">Update password</button>
    </form>
    <% } %>
    <p style="text-align:center;margin-top:20px;font-size:13px;color:#6b7280;">
      <a href="/login" style="color:#16a34a;font-weight:500;">Back to sign in</a>
    </p>
  </div>
</div>
</body>
</html>
