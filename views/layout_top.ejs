<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title||'TennisTrack' %></title>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="sidebar-overlay" id="overlay" onclick="closeSidebar()"></div>
<div class="app-layout">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-text"><div class="logo-icon">🎾</div>TennisTrack</div>
    </div>
    <div class="sidebar-user">
      <div class="user-name"><%= user.full_name||user.username %></div>
      <div class="user-sub">@<%= user.username %> <% if(user.is_admin){ %><span class="admin-badge">ADMIN</span><% } %></div>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-item <%= page==='dashboard'?'active':'' %>"><span class="nav-icon">📊</span> Dashboard</a>
      <a href="/matches" class="nav-item <%= page==='matches'?'active':'' %>"><span class="nav-icon">🏆</span> Match History</a>
      <a href="/matches/new" class="nav-item <%= page==='new_match'?'active':'' %>"><span class="nav-icon">➕</span> Log Match</a>
      <a href="/schedule" class="nav-item <%= page==='schedule'?'active':'' %>"><span class="nav-icon">📅</span> Schedule</a>
      <a href="/compare" class="nav-item <%= page==='compare'?'active':'' %>"><span class="nav-icon">⚔️</span> Compare</a>
      <a href="/leagues" class="nav-item <%= page==='leagues'?'active':'' %>"><span class="nav-icon">🏅</span> Leagues</a>
      <a href="/clubs" class="nav-item <%= page==='clubs'?'active':'' %>"><span class="nav-icon">🏢</span> Clubs</a>
      <a href="/notifications" class="nav-item <%= page==='notifications'?'active':'' %>">
        <span class="nav-icon">🔔</span> Notifications
        <% if(unreadCount>0){ %><span class="notif-badge"><%= unreadCount %></span><% } %>
      </a>
      <a href="/profile" class="nav-item <%= page==='profile'?'active':'' %>"><span class="nav-icon">👤</span> Profile</a>
      <% if(isAdmin){ %>
      <a href="/admin" class="nav-item <%= page==='admin'?'active':'' %>" style="margin-top:8px;border-top:1px solid rgba(255,255,255,.1);"><span class="nav-icon">🛡️</span> Admin Panel</a>
      <% } %>
    </nav>
    <div class="sidebar-footer"><a href="/logout"><span>🚪</span> Sign out</a></div>
  </aside>
  <div class="main-content">
    <header class="topbar">
      <div style="display:flex;align-items:center;gap:12px;">
        <button class="hamburger" onclick="toggleSidebar()"><span></span><span></span><span></span></button>
        <span class="topbar-title"><%= title||'TennisTrack' %></span>
      </div>
      <div class="topbar-right">
        <a href="/notifications" style="position:relative;margin-right:4px;">
          <button class="btn btn-outline btn-sm">🔔<% if(unreadCount>0){ %> <span style="background:#dc2626;color:#fff;border-radius:999px;padding:1px 6px;font-size:10px;"><%= unreadCount %></span><% } %></button>
        </a>
      </div>
    </header>
    <main class="page-content">
