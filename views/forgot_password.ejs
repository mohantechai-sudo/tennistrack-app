<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Forgot Password — TennisTrack</title>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <div class="logo-circle">🎾</div>
      <h1>TennisTrack</h1>
      <p>Reset your password</p>
    </div>
    <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
    <% } else { %>
    <p style="font-size:13px;color:#6b7280;margin-bottom:16px;">Enter your account email and we'll send you a reset link.</p>
    <form method="POST" action="/forgot-password">
      <div class="form-group">
        <label class="form-label">Email address</label>
        <input class="form-input" name="email" type="email" placeholder="Enter your email" required autofocus/>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;">Send reset link</button>
    </form>
    <% } %>
    <p style="text-align:center;margin-top:20px;font-size:13px;color:#6b7280;">
      <a href="/login" style="color:#16a34a;font-weight:500;">Back to sign in</a>
    </p>
  </div>
</div>
</body>
</html>
