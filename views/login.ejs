<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Sign in — TennisTrack</title>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <div class="logo-circle">🎾</div>
      <h1>TennisTrack</h1>
      <p>Sign in to your account</p>
    </div>
    <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (unverifiedEmail) { %>
    <div style="background:#fefce8;border:1px solid #fde68a;border-radius:10px;padding:16px;margin-bottom:18px;">
      <div style="display:flex;gap:10px;align-items:flex-start;">
        <span style="font-size:20px;flex-shrink:0;">📧</span>
        <div>
          <div style="font-weight:600;color:#92400e;font-size:14px;">Email not verified</div>
          <div style="font-size:13px;color:#78350f;margin-top:3px;">Check your inbox at <strong><%= unverifiedEmail %></strong> and click the verification link to activate your account.</div>
          <form method="POST" action="/resend-verification" style="margin-top:10px;">
            <input type="hidden" name="email" value="<%= unverifiedEmail %>"/>
            <button type="submit" style="font-size:12px;padding:5px 14px;background:#f59e0b;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:600;">↩ Resend verification email</button>
          </form>
        </div>
      </div>
    </div>
    <% } %>
    <form method="POST" action="/login">
      <div class="form-group">
        <label class="form-label">Username or email</label>
        <input class="form-input" name="username" type="text" placeholder="Enter username or email" required autofocus/>
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input class="form-input" name="password" type="password" placeholder="Enter password" required/>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;">Sign in</button>
    </form>
    <p style="text-align:center;margin-top:16px;font-size:13px;">
      <a href="/forgot-password" style="color:#6b7280;">Forgot password?</a>
    </p>
    <p style="text-align:center;margin-top:8px;font-size:13px;color:#6b7280;">
      No account? <a href="/register" style="color:#16a34a;font-weight:500;">Create one</a>
    </p>
  </div>
</div>
</body>
</html>
