<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Sign in — TennisTrack</title>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <div class="logo-circle">🎾</div>
      <h1>TennisTrack</h1>
      <p>Sign in to your account</p>
    </div>
    <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form method="POST" action="/login">
      <div class="form-group">
        <label class="form-label">Username or email</label>
        <input class="form-input" name="username" type="text" placeholder="Enter username or email" required autofocus/>
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input class="form-input" name="password" type="password" placeholder="Enter password" required/>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;">Sign in</button>
    </form>
    <p style="text-align:center;margin-top:16px;font-size:13px;">
      <a href="/forgot-password" style="color:#6b7280;">Forgot password?</a>
    </p>
    <p style="text-align:center;margin-top:8px;font-size:13px;color:#6b7280;">
      No account? <a href="/register" style="color:#16a34a;font-weight:500;">Create one</a>
    </p>
  </div>
</div>
</body>
</html>
