<script>
(function(){
  function populateSelect(sel, teams, preId, exclude) {
    sel.innerHTML = '';
    teams.filter(t => t.id !== exclude).forEach(t => {
      const o = document.createElement('option');
      o.value = t.id;
      o.textContent = t.name + ' (' + t.p1name + ' & ' + t.p2name + ')';
      sel.appendChild(o);
    });
    if (preId) sel.value = preId;
  }

  window.openScheduleModal = function(btn) {
    const poolId = btn.dataset.pool;
    const teams  = JSON.parse(btn.dataset.teams);
    const preId  = parseInt(btn.dataset.pre);
    document.getElementById('sm-pool-id').value = poolId;
    const t1 = document.getElementById('sm-team1');
    const t2 = document.getElementById('sm-team2');
    populateSelect(t1, teams, preId);
    const other = teams.find(t => t.id !== preId);
    populateSelect(t2, teams, other ? other.id : null, preId);
    t1.onchange = function() { populateSelect(t2, teams, null, parseInt(t1.value)); };
    const m = document.getElementById('modal-schedule');
    m.style.display = 'flex';
  };

  window.openScoreModal = function(btn) {
    const poolId = btn.dataset.pool;
    const teams  = JSON.parse(btn.dataset.teams);
    const preId  = parseInt(btn.dataset.pre);
    document.getElementById('rm-pool-id').value = poolId;
    const t1 = document.getElementById('rm-team1');
    const t2 = document.getElementById('rm-team2');
    const winner = document.getElementById('rm-winner');
    populateSelect(t1, teams, preId);
    const other = teams.find(t => t.id !== preId);
    populateSelect(t2, teams, other ? other.id : null, preId);
    function syncWinner() {
      const v1 = parseInt(t1.value), v2 = parseInt(t2.value);
      winner.innerHTML = '<option value="">— No result yet —</option>';
      teams.filter(t => t.id===v1 || t.id===v2).forEach(t => {
        const o = document.createElement('option');
        o.value = t.id; o.textContent = t.name + ' wins';
        winner.appendChild(o);
      });
    }
    t1.onchange = function() { populateSelect(t2, teams, null, parseInt(t1.value)); syncWinner(); };
    t2.onchange = syncWinner;
    syncWinner();
    const m = document.getElementById('modal-score');
    m.style.display = 'flex';
  };

  window.closeModals = function() {
    document.getElementById('modal-schedule').style.display = 'none';
    document.getElementById('modal-score').style.display = 'none';
    const lm = document.getElementById('modal-log-match');
    if (lm) lm.style.display = 'none';
  };

  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModals(); });

  ['modal-schedule','modal-score'].forEach(id => {
    document.getElementById(id).addEventListener('click', function(e) { if (e.target===this) closeModals(); });
  });
})();
</script>
<% } %>

<!-- Match History -->
<div class="card">
  <div class="card-header"><div class="card-title">Match History</div><span style="font-size:13px;color:var(--gray-500);"><%= lmatches.length %> matches</span></div>
  <% if(lmatches.length===0){ %>
  <div class="empty-state" style="padding:32px;"><div class="empty-icon">🎾</div><div class="empty-text">No matches logged yet</div></div>
  <% } else { %>
  <div class="match-list">
    <% lmatches.forEach(m=>{ %>
    <%
      const isD = m.match_type==='doubles';
      const onT1 = m.player1_id===uid || m.player1_partner_id===uid;
      const onT2 = m.player2_id===uid || m.player2_partner_id===uid;
      const involved = onT1||onT2;
      const t1won = m.winner_id && (m.winner_id===m.player1_id || m.winner_id===m.player1_partner_id);
      const t2won = m.winner_id && (m.winner_id===m.player2_id || m.winner_id===m.player2_partner_id);
      const myWin = involved && ((onT1&&t1won)||(onT2&&t2won));
      const myLoss = involved && m.winner_id && !myWin;
      const oc = myWin?'win':myLoss?'loss':'nr';
      const t1label = isD&&m.p1partnername ? `${m.p1name} & ${m.p1partnername}` : m.p1name;
      const t2label = isD&&m.p2partnername ? `${m.p2name} & ${m.p2partnername}` : m.p2name;
      const winnerLabel = t1won ? t1label : t2won ? t2label : null;
    %>
    <div class="match-row">
      <% if(involved){ %>
      <div class="match-outcome outcome-<%= oc %>"><%= oc==='win'?'W':oc==='loss'?'L':'–' %></div>
      <% } else { %>
      <div style="width:32px;text-align:center;font-size:14px;">🎾</div>
      <% } %>
      <div class="match-vs" style="flex:1;min-width:0;">
        <div class="vs-text" style="font-size:13px;"><strong><%= t1label %></strong> vs <strong><%= t2label %></strong></div>
        <div class="vs-sub">
          <%= fmtDate(m.played_at) %>
          <% if(m.venue){ %> · 📍 <%= m.venue %><% } %>
          <% if(winnerLabel){ %> · 🏆 <%= winnerLabel %><% } %>
        </div>
      </div>
      <span class="match-surface <%= surfaceClass(m.surface) %>"><%= m.surface %></span>
      <span style="font-size:11px;font-weight:500;padding:2px 7px;border-radius:999px;background:<%= isD?'#ede9fe':'#dcfce7' %>;color:<%= isD?'#7c3aed':'#166534' %>;"><%= isD?'doubles':'singles' %></span>
      <div class="match-score"><%= m.score %></div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<style>
@media(max-width:640px){.league-grid{grid-template-columns:1fr!important;}}
.ldc-cell{min-height:80px;border-right:1px solid var(--gray-100);border-bottom:1px solid var(--gray-100);padding:5px;position:relative;box-sizing:border-box;}
.ldc-cell:nth-child(7n){border-right:none;}
.ldc-cell:hover .ldc-add-btn{opacity:1!important;}
.ldc-pill{font-size:11px;font-weight:500;padding:2px 6px;border-radius:4px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;line-height:1.5;}
.ldc-pill:hover{filter:brightness(.9);}
.ldc-day-num{font-size:12px;font-weight:600;margin-bottom:3px;width:22px;height:22px;display:flex;align-items:center;justify-content:center;border-radius:50%;}
</style>

<%
  /* Build calendar events for inline popup */
  const _calEvts = [];
  (lmatches||[]).filter(m=>m.played_at).forEach(m=>{
    const onT1 = m.player1_id===uid||m.player1_partner_id===uid;
    const oppName = onT1?(m.p2full||m.p2name):(m.p1full||m.p1name);
    _calEvts.push({id:'m-'+m.id,type:'match',date:m.played_at.slice(0,10),time:m.played_at.length>10?m.played_at.slice(11,16):'',label:'vs '+oppName,color:'#536D33',score:m.score||'',p1name:m.p1full||m.p1name,p2name:m.p2full||m.p2name,p1partner:m.p1partnername||'',p2partner:m.p2partnername||'',surface:m.surface,venue:m.venue||'',myWin:m.winner_id&&(m.winner_id===m.player1_id||m.winner_id===m.player1_partner_id)===(m.player1_id===uid||m.player1_partner_id===uid)});
  });
  (calProposals.accepted||[]).forEach(p=>{
    if(!p.accepted_at)return;
    const iAmP=p.proposer_id===uid;
    const oppN=iAmP?(p.opponent_full||p.opponent_name):(p.proposer_full||p.proposer_name);
    _calEvts.push({id:'s-'+p.id,type:'scheduled',date:p.accepted_at.slice(0,10),time:p.accepted_at.length>10?p.accepted_at.slice(11,16):'',label:'vs '+oppN,color:'#1d4ed8',proposalId:p.id,oppName:oppN,venue:p.venue||'',surface:p.surface,iAmProposer:iAmP,proposerId:p.proposer_id,opponentId:p.opponent_id});
  });
  (calProposals.incoming||[]).forEach(p=>{ p.slots.forEach(s=>{ _calEvts.push({id:'i-'+p.id+'-'+s.id,type:'incoming',date:s.proposed_at.slice(0,10),time:s.proposed_at.length>10?s.proposed_at.slice(11,16):'',label:'📬 '+(p.proposer_full||p.proposer_name),color:'#7c3aed',proposalId:p.id,slotId:s.id,oppName:p.proposer_full||p.proposer_name,venue:p.venue||'',surface:p.surface,notes:p.notes||'',allSlots:p.slots.map(sl=>({id:sl.id,dt:sl.proposed_at}))}); }); });
  (calProposals.outgoing||[]).forEach(p=>{ p.slots.forEach(s=>{ _calEvts.push({id:'o-'+p.id+'-'+s.id,type:'outgoing',date:s.proposed_at.slice(0,10),time:s.proposed_at.length>10?s.proposed_at.slice(11,16):'',label:'📤 '+(p.opponent_full||p.opponent_name),color:'#d97706',proposalId:p.id,slotId:s.id,oppName:p.opponent_full||p.opponent_name,venue:p.venue||'',surface:p.surface,notes:p.notes||'',allSlots:p.slots.map(sl=>({id:sl.id,dt:sl.proposed_at}))}); }); });
  const _isDoublesLeague = ['mens_doubles','womens_doubles','mixed_doubles'].includes(league.category||'');
%>

<!-- ── Calendar Popup Modal ─────────────────────────────────────────────── -->
<div id="ldc-backdrop" onclick="if(event.target===this)ldcClose()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:1100;align-items:flex-start;justify-content:center;padding:16px;overflow-y:auto;">
