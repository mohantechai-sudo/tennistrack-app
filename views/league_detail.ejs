<%
  function fmtDate(d){return new Date(d).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});}
  function surfaceClass(s){const m={hard:'surface-hard',clay:'surface-clay',grass:'surface-grass',indoor:'surface-indoor'};return m[s]||'surface-hard';}
  const CAT_LABEL = {mens_singles:"Men's Singles",mens_doubles:"Men's Doubles",womens_singles:"Women's Singles",womens_doubles:"Women's Doubles",mixed_doubles:"Mixed Doubles",open:"Open"};
  const CAT_ICON  = {mens_singles:'👨',mens_doubles:'👬',womens_singles:'👩',womens_doubles:'👭',mixed_doubles:'👫',open:'🎾'};
  const CAT_COLOR = {mens_singles:'#1d4ed8',mens_doubles:'#1d4ed8',womens_singles:'#be185d',womens_doubles:'#be185d',mixed_doubles:'#7c3aed',open:'#374151'};
  const CAT_BG    = {mens_singles:'#dbeafe',mens_doubles:'#dbeafe',womens_singles:'#fce7f3',womens_doubles:'#fce7f3',mixed_doubles:'#ede9fe',open:'#f3f4f6'};
  const cat = league.category||'open';
  const isDoublesCat = ['mens_doubles','womens_doubles','mixed_doubles'].includes(cat);
  const isSinglesCat = ['mens_singles','womens_singles'].includes(cat);
  const autoType = isDoublesCat ? 'Doubles' : isSinglesCat ? 'Singles' : null;
%>
<%
  const ENROLL_LABEL = {open:'Open Enrollment',invite_only:'Invite Only',closed:'Closed'};
  const ENROLL_COLOR = {open:'var(--green-600)',invite_only:'#1d4ed8',closed:'#dc2626'};
  const enrollKey = league.enrollment||'open';
  const playerLimit = plan.playerLimit===9999?'∞':plan.playerLimit;
  const usagePct = plan.playerLimit===9999 ? 0 : Math.min(100,Math.round((members.length/plan.playerLimit)*100));
  const _pools = (typeof pools !== 'undefined' ? pools : []);
  const _tsMap = {}; (teamStandings||[]).forEach(ts=>{ _tsMap[ts.key]=ts; });
  const _ap = acceptedProposals || [];
  // Returns the next future accepted proposal involving a set of playerIds, or null
  function _nextConfirmed(playerIds) {
    const ids = new Set(playerIds);
    const now = new Date();
    return _ap
      .filter(p => ids.has(p.proposer_id) || ids.has(p.opponent_id))
      .filter(p => new Date(p.scheduled_at) > now)
      .sort((a,b) => new Date(a.scheduled_at)-new Date(b.scheduled_at))[0] || null;
  }
  function _fmtConfirmed(p) {
    const d = new Date(p.scheduled_at);
    return d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'})
      + ' · ' + d.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});
  }
%>
<%- include('layout_top',{title:league.name,page:'leagues',user}) %>

<% if(error){ %><div class="alert alert-error" style="margin-bottom:16px;"><%= error %></div><% } %>
<% if(success){ %><div class="alert alert-success" style="margin-bottom:16px;"><%= success %></div><% } %>
<% if(joinErr==='limit'){ %><div class="alert alert-error" style="margin-bottom:16px;">⚠️ This league has reached its player limit. Ask the organiser to upgrade the plan.</div><% } %>
<% if(joinErr==='invite_only'){ %><div class="alert alert-error" style="margin-bottom:16px;">🔒 This league is invite-only. Ask the organiser to send you an invite link.</div><% } %>
<% if(joinErr==='closed'){ %><div class="alert alert-error" style="margin-bottom:16px;">🔒 This league is closed to new players.</div><% } %>

<!-- Header -->
<div class="card" style="margin-bottom:20px;border-top:3px solid <%= plan.color %>;">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;">
    <div>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <h2 style="font-size:20px;font-weight:700;color:var(--gray-800);margin:0;"><%= league.name %></h2>
        <span style="font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;background:<%= plan.bg %>;color:<%= plan.color %>;"><%= plan.label %> Plan</span>
        <% const _sb=league.status==='active'?{bg:'var(--green-100)',c:'var(--green-700)',l:'Active'}:league.status==='draft'?{bg:'#fef3c7',c:'#b45309',l:'Draft'}:{bg:'var(--gray-100)',c:'var(--gray-500)',l:'Ended'}; %>
        <span style="font-size:11px;font-weight:600;padding:3px 10px;border-radius:999px;background:<%= _sb.bg %>;color:<%= _sb.c %>;">
          <%= _sb.l %>
        </span>
      </div>
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:8px;">
        <span style="display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:600;padding:3px 10px;border-radius:999px;background:<%= CAT_BG[cat] %>;color:<%= CAT_COLOR[cat] %>;">
          <%= CAT_ICON[cat] %> <%= CAT_LABEL[cat] %>
        </span>
        <span style="font-size:12px;color:<%= ENROLL_COLOR[enrollKey] %>;font-weight:600;">● <%= ENROLL_LABEL[enrollKey] %></span>
        <span style="font-size:13px;color:var(--gray-500);">📋 <%= league.format==='round_robin'?'Round Robin':'Knockout' %></span>
        <span style="font-size:13px;color:var(--gray-500);">👤 @<%= league.creator_name %></span>
        <span style="font-size:13px;color:var(--gray-500);">📅 <%= fmtDate(league.created_at) %></span>
      </div>
      <% if(league.description){ %><div style="font-size:13px;color:var(--gray-600);margin-top:4px;"><%= league.description %></div><% } %>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <a href="/leagues" class="btn btn-outline btn-sm">← All Leagues</a>
      <a href="/leagues/<%= league.id %>/dashboard" class="btn btn-outline btn-sm">📊 Dashboard</a>
      <% if(isMember){ %><a href="/leagues/<%= league.id %>/calendar" class="btn btn-outline btn-sm">📅 Calendar</a><% } %>
      <% if(league.status==='active' && _pools.length > 0 && (isMember||isCreator)){ %>
      <button class="btn btn-outline btn-sm" onclick="document.getElementById('modal-fixtures').style.display='flex'">📋 Fixtures</button>
      <% } %>
      <% if(isCreator){ %><a href="/leagues/<%= league.id %>/settings" class="btn btn-outline btn-sm">⚙️ Settings</a><% } %>
      <% if(isMember && league.status==='active'){ %>
      <button class="btn btn-primary btn-sm" onclick="document.getElementById('modal-log-match').style.display='flex'">📝 Log Match</button>
      <% } %>
      <% if(!isMember && league.status==='active' && enrollKey==='open'){ %>
      <form method="POST" action="/leagues/<%= league.id %>/join" style="margin:0;">
        <button type="submit" class="btn btn-primary btn-sm">Join League</button>
      </form>
      <% } %>
      <% if(isMember && !isCreator){ %>
      <form method="POST" action="/leagues/<%= league.id %>/leave" style="margin:0;" onsubmit="return confirm('Leave this league?')">
        <button type="submit" class="btn btn-outline btn-sm" style="color:#dc2626;border-color:#fecaca;">Leave</button>
      </form>
      <% } %>
      <% if(isCreator && league.status==='draft'){ %>
      <form method="POST" action="/leagues/<%= league.id %>/start" style="margin:0;">
        <button type="submit" class="btn btn-primary btn-sm">🚀 Start League</button>
      </form>
      <% } %>
      <% if(isCreator && league.status==='active'){ %>
      <form method="POST" action="/leagues/<%= league.id %>/end" style="margin:0;" onsubmit="return confirm('End this league? This cannot be undone.')">
        <button type="submit" class="btn btn-outline btn-sm" style="color:#dc2626;border-color:#fecaca;">End League</button>
      </form>
      <% } %>
    </div>
  </div>

  <!-- Player usage bar -->
  <div style="margin-top:16px;border-top:1px solid var(--gray-100);padding-top:14px;">
    <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--gray-500);margin-bottom:6px;">
      <span>Players — <strong style="color:var(--gray-700);"><%= members.length %> / <%= playerLimit %></strong></span>
      <% if(isCreator && plan.label!=='Premium'){ %>
      <a href="/leagues/<%= league.id %>/settings#plans" style="font-size:12px;color:<%= plan.color %>;font-weight:600;">Upgrade plan →</a>
      <% } %>
    </div>
    <% if(plan.playerLimit!==9999){ %>
    <div style="background:var(--gray-100);border-radius:999px;height:6px;overflow:hidden;">
      <div style="width:<%= usagePct %>%;height:100%;background:<%= usagePct>=90?'#dc2626':plan.color %>;border-radius:999px;transition:.3s;"></div>
    </div>
    <% } %>
  </div>
</div>

<% if(isCreator && (league.status==='draft' || (league.status==='active' && _pools.length===0))){ %>
<div style="background:#fef3c7;border:1.5px solid #fde68a;border-radius:10px;padding:14px 18px;margin-bottom:16px;display:flex;align-items:flex-start;gap:12px;">
  <span style="font-size:22px;line-height:1;"><%= league.status==='draft'?'⚙️':'⚠️' %></span>
  <div>
    <% if(league.status==='draft'){ %>
    <div style="font-weight:600;color:#92400e;font-size:14px;margin-bottom:3px;">League is in Draft mode</div>
    <div style="font-size:13px;color:#b45309;">Use the pool builder below to create pools and assign players/teams. When ready, click <strong>🚀 Start League</strong> in the header to publish standings and enable match scheduling.</div>
    <% } else { %>
    <div style="font-weight:600;color:#92400e;font-size:14px;margin-bottom:3px;">No pools set up yet</div>
    <div style="font-size:13px;color:#b45309;">Create pools below and save them to enable pool standings and match scheduling.</div>
    <% } %>
  </div>
</div>
<% } %>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;" class="league-grid">

  <!-- Standings -->
  <div class="card">
    <div class="card-header"><div class="card-title">🏆 Standings</div><span style="font-size:12px;color:var(--gray-400);">Win = 2 pts</span></div>
    <% const showTeams = teamStandings && isDoublesCat; %>
    <% const standingRows = showTeams ? teamStandings : standings; %>
    <% if(standingRows.length===0){ %>
    <div class="empty-state" style="padding:24px;"><div class="empty-icon">📊</div><div class="empty-text">No matches yet</div></div>
    <% } else { %>
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
      <thead>
        <tr style="color:var(--gray-400);border-bottom:1px solid var(--gray-100);">
          <th style="text-align:left;padding:6px 4px;font-weight:500;">#</th>
          <th style="text-align:left;padding:6px 4px;font-weight:500;"><%= showTeams ? 'Team' : 'Player' %></th>
          <th style="text-align:center;padding:6px 4px;font-weight:500;">P</th>
          <th style="text-align:center;padding:6px 4px;font-weight:500;">W</th>
          <th style="text-align:center;padding:6px 4px;font-weight:500;">L</th>
          <th style="text-align:center;padding:6px 4px;font-weight:500;">Pts</th>
        </tr>
      </thead>
      <tbody>
        <% standingRows.forEach((s,i)=>{ %>
        <% if(showTeams){ %>
        <%   const myTeam = s.ids && s.ids.includes(uid); %>
        <tr style="border-bottom:1px solid var(--gray-50);<%= myTeam?'background:var(--green-50);':'' %>">
          <td style="padding:8px 4px;color:var(--gray-400);font-weight:600;"><%= i+1 %></td>
          <td style="padding:8px 4px;">
            <span style="font-weight:<%= myTeam?'700':'500' %>;color:<%= myTeam?'var(--green-700)':'var(--gray-800)' %>;">
              <%= s.names.join(' & ') %>
            </span>
            <% if(myTeam){ %><span style="font-size:10px;color:var(--green-600);margin-left:4px;">(you)</span><% } %>
          </td>
          <td style="text-align:center;padding:8px 4px;color:var(--gray-500);"><%= s.played %></td>
          <td style="text-align:center;padding:8px 4px;color:var(--green-600);font-weight:600;"><%= s.wins %></td>
          <td style="text-align:center;padding:8px 4px;color:#dc2626;"><%= s.losses %></td>
          <td style="text-align:center;padding:8px 4px;font-weight:700;color:var(--gray-800);"><%= s.points %></td>
        </tr>
        <% } else { %>
        <tr style="border-bottom:1px solid var(--gray-50);<%= s.id===uid?'background:var(--green-50);':'' %>">
          <td style="padding:8px 4px;color:var(--gray-400);font-weight:600;"><%= i+1 %></td>
          <td style="padding:8px 4px;">
            <a href="/leagues/<%= league.id %>/player/<%= s.id %>" style="font-weight:<%= s.id===uid?'700':'500' %>;color:<%= s.id===uid?'var(--green-700)':'var(--gray-800)' %>;text-decoration:none;">
              <%= s.full_name||s.username %>
            </a>
            <% if(s.id===uid){ %><span style="font-size:10px;color:var(--green-600);margin-left:4px;">(you)</span><% } %>
          </td>
          <td style="text-align:center;padding:8px 4px;color:var(--gray-500);"><%= s.played %></td>
          <td style="text-align:center;padding:8px 4px;color:var(--green-600);font-weight:600;"><%= s.wins %></td>
          <td style="text-align:center;padding:8px 4px;color:#dc2626;"><%= s.losses %></td>
          <td style="text-align:center;padding:8px 4px;font-weight:700;color:var(--gray-800);"><%= s.points %></td>
        </tr>
        <% } %>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>

  <!-- Members + Log Match -->
  <div style="display:flex;flex-direction:column;gap:14px;">
    <div class="card">
      <div class="card-header"><div class="card-title">👥 Members</div><span style="font-size:13px;color:var(--gray-500);"><%= members.length %> / <%= playerLimit %> players</span></div>
      <div style="display:flex;flex-wrap:wrap;gap:8px;padding-top:4px;">
        <% members.forEach(m=>{ %>
        <a href="/leagues/<%= league.id %>/player/<%= m.id %>" style="font-size:13px;padding:4px 10px;border-radius:999px;background:<%= m.id===uid?'var(--green-100)':'var(--gray-100)' %>;color:<%= m.id===uid?'var(--green-700)':'var(--gray-600)' %>;font-weight:<%= m.id===uid?'600':'400' %>;text-decoration:none;">
          @<%= m.username %>
        </a>
        <% }) %>
      </div>
    </div>

  </div>
</div>

<!-- Log Match Modal -->
<% if(isMember && league.status==='active') { %>
<div id="modal-log-match" onclick="if(event.target===this)this.style.display='none'" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;">
  <div onclick="event.stopPropagation()" style="background:#fff;border-radius:14px;padding:28px;width:100%;max-width:520px;margin:16px;box-shadow:0 20px 60px rgba(0,0,0,.2);position:relative;max-height:90vh;overflow-y:auto;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <div>
        <div style="font-size:18px;font-weight:700;color:var(--gray-800);">📝 Log Match</div>
        <% if(autoType){ %><div style="font-size:13px;color:var(--gray-400);margin-top:2px;"><%= autoType %></div><% } %>
      </div>
      <button onclick="document.getElementById('modal-log-match').style.display='none'" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--gray-400);padding:4px;line-height:1;" title="Close">✕</button>
    </div>
    <form method="POST" action="/leagues/<%= league.id %>/match">
      <% if(autoType){ %><input type="hidden" name="match_type" value="<%= autoType.toLowerCase() %>"/><% } %>

      <% if(isDoublesCat){ %>
      <div class="form-group">
        <label class="form-label">Your partner</label>
        <select class="form-input" name="partner_id" required>
          <option value="">— Select your partner —</option>
          <% members.filter(m=>m.id!==uid).forEach(m=>{ %>
          <option value="<%= m.id %>"><%= m.full_name||m.username %> (@<%= m.username %>)</option>
          <% }) %>
        </select>
      </div>
      <div style="font-size:11px;font-weight:600;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;margin:10px 0 6px;">Opponent team</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div class="form-group">
          <label class="form-label">Opponent 1</label>
          <select class="form-input" name="opponent_id" required>
            <option value="">— Select —</option>
            <% members.filter(m=>m.id!==uid).forEach(m=>{ %>
            <option value="<%= m.id %>"><%= m.full_name||m.username %> (@<%= m.username %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Opponent 2</label>
          <select class="form-input" name="opponent_partner_id" required>
            <option value="">— Select —</option>
            <% members.filter(m=>m.id!==uid).forEach(m=>{ %>
            <option value="<%= m.id %>"><%= m.full_name||m.username %> (@<%= m.username %>)</option>
            <% }) %>
          </select>
        </div>
      </div>
      <% } else { %>
      <div class="form-group">
        <label class="form-label">Opponent</label>
        <select class="form-input" name="opponent_id" required>
          <option value="">— Select opponent —</option>
          <% members.filter(m=>m.id!==uid).forEach(m=>{ %>
          <option value="<%= m.id %>"><%= m.full_name||m.username %> (@<%= m.username %>)</option>
          <% }) %>
        </select>
      </div>
      <% } %>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div class="form-group">
          <label class="form-label">Score</label>
          <input class="form-input" name="score" type="text" placeholder="e.g. 6-3, 6-4" required/>
        </div>
        <div class="form-group">
          <label class="form-label">Court Type</label>
          <select class="form-input" name="surface">
            <option value="hard">Hard</option>
            <option value="clay">Clay</option>
            <option value="grass">Grass</option>
            <option value="indoor">Indoor</option>
          </select>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div class="form-group">
          <label class="form-label">Date & Time</label>
          <input class="form-input" name="played_at" type="datetime-local"/>
        </div>
        <div class="form-group">
          <label class="form-label">Location</label>
          <input class="form-input" name="venue" type="text" placeholder="e.g. City Tennis Club, Court 3"/>
        </div>
      </div>

      <% if(!autoType){ %>
      <div class="form-group">
        <label class="form-label">Match type</label>
        <select class="form-input" name="match_type">
          <option value="singles">Singles</option>
          <option value="doubles">Doubles</option>
        </select>
      </div>
      <% } %>

      <div class="form-group">
        <label class="form-label">Winner</label>
        <% if(isDoublesCat){ %>
        <select class="form-input" name="winner_id">
          <option value="">No result / walkover</option>
          <option value="<%= uid %>">My team won</option>
          <option value="_opp">Opponent team won</option>
        </select>
        <% } else { %>
        <select class="form-input" name="winner_id">
          <option value="">No result / walkover</option>
          <option value="<%= uid %>"><%= user.full_name||user.username %> (you)</option>
          <% members.filter(m=>m.id!==uid).forEach(m=>{ %>
          <option value="<%= m.id %>"><%= m.full_name||m.username %></option>
          <% }) %>
        </select>
        <% } %>
      </div>
      <div style="display:flex;gap:10px;margin-top:4px;">
        <button type="submit" class="btn btn-primary" style="flex:1;">Save Match</button>
        <button type="button" onclick="document.getElementById('modal-log-match').style.display='none'" class="btn btn-outline">Cancel</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<!-- Teams Section -->
<% if(isCreator || teams.length > 0){ %>
<div class="card" id="teams" style="margin-bottom:20px;">
  <div class="card-header" style="margin-bottom:12px;">
    <div class="card-title">👥 Doubles Teams</div>
    <% if(isCreator){ %>
    <button class="btn btn-primary btn-sm" onclick="toggleBuilder(this)">+ Build Team</button>
    <% } %>
  </div>

  <!-- Existing teams grid -->
  <% if(teams.length > 0){ %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px;<%= isCreator?'margin-bottom:16px;':'' %>">
    <% teams.forEach(t=>{ %>
    <div style="border:2px solid <%= t.color %>;border-radius:10px;overflow:hidden;">
      <div style="background:<%= t.color %>;padding:8px 14px;display:flex;justify-content:space-between;align-items:center;">
        <span style="color:#fff;font-weight:700;font-size:14px;letter-spacing:.01em;"><%= t.name %></span>
        <% if(isCreator){ %>
        <form method="POST" action="/leagues/<%= league.id %>/teams/<%= t.id %>/delete" style="margin:0;" onsubmit="return confirm('Remove this team?')">
          <button type="submit" style="background:rgba(255,255,255,.25);border:none;color:#fff;cursor:pointer;border-radius:4px;padding:1px 7px;font-size:14px;line-height:1.6;">✕</button>
        </form>
        <% } %>
      </div>
      <div style="padding:10px 14px;background:#fff;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:7px;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--gray-100);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:<%= t.color %>;flex-shrink:0;"><%= (t.p1full||t.p1name).charAt(0).toUpperCase() %></div>
          <span style="font-size:13px;font-weight:600;color:var(--gray-800);"><%= t.p1full||t.p1name %></span>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--gray-100);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:<%= t.color %>;flex-shrink:0;"><%= (t.p2full||t.p2name).charAt(0).toUpperCase() %></div>
          <span style="font-size:13px;font-weight:600;color:var(--gray-800);"><%= t.p2full||t.p2name %></span>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else if(isCreator){ %>
  <div class="empty-state" style="padding:20px 0 10px;"><div class="empty-icon">👥</div><div class="empty-text" style="font-size:13px;">No teams yet — build your first team below</div></div>
  <% } %>

  <!-- Drag-and-drop team builder (creator only) -->
  <% if(isCreator){ %>
  <div id="teamBuilder" style="display:none;border-top:1px solid var(--gray-100);padding-top:16px;margin-top:4px;">
    <div style="font-size:13px;color:var(--gray-500);margin-bottom:12px;">Drag players from the pool into the two team slots, pick a color, name the team and save.</div>

    <!-- Player pool -->
    <div style="margin-bottom:16px;">
      <div style="font-size:11px;font-weight:600;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;">Player Pool — drag to slots</div>
      <div id="playerPool" style="display:flex;flex-wrap:wrap;gap:8px;min-height:48px;padding:10px;background:var(--gray-50);border:2px dashed var(--gray-200);border-radius:8px;">
        <% members.forEach(m=>{ %>
        <div class="player-chip" draggable="true"
          data-id="<%= m.id %>" data-name="<%= m.full_name||m.username %>"
          style="padding:6px 14px;border-radius:999px;background:#fff;border:2px solid var(--gray-200);color:var(--gray-700);font-size:13px;font-weight:500;cursor:grab;user-select:none;transition:.15s;">
          <%= m.full_name||m.username %>
          <span style="font-size:11px;color:var(--gray-400);margin-left:3px;">@<%= m.username %></span>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- Drop slots + form -->
    <form method="POST" action="/leagues/<%= league.id %>/teams" id="teamForm">
      <input type="hidden" name="player1_id" id="tb_p1id"/>
      <input type="hidden" name="player2_id" id="tb_p2id"/>
      <input type="hidden" name="color" id="tb_color" value="#1d4ed8"/>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
        <div class="team-slot" id="slot1" data-slot="1"
          style="min-height:64px;border:2px dashed var(--gray-300);border-radius:8px;display:flex;align-items:center;justify-content:center;padding:10px;transition:.2s;cursor:pointer;"
          ondragover="slotOver(event,this)" ondragleave="slotLeave(this)" ondrop="slotDrop(event,this)">
          <span style="color:var(--gray-400);font-size:13px;pointer-events:none;">Drop Player 1 here</span>
        </div>
        <div class="team-slot" id="slot2" data-slot="2"
          style="min-height:64px;border:2px dashed var(--gray-300);border-radius:8px;display:flex;align-items:center;justify-content:center;padding:10px;transition:.2s;cursor:pointer;"
          ondragover="slotOver(event,this)" ondragleave="slotLeave(this)" ondrop="slotDrop(event,this)">
          <span style="color:var(--gray-400);font-size:13px;pointer-events:none;">Drop Player 2 here</span>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr auto;gap:14px;align-items:end;margin-bottom:16px;">
        <div class="form-group" style="margin:0;">
          <label class="form-label">Team Name</label>
          <input class="form-input" name="name" id="tb_name" type="text" placeholder="e.g. Thunder Pair" required/>
        </div>
        <div>
          <div style="font-size:12px;font-weight:500;color:var(--gray-600);margin-bottom:6px;">Team Color</div>
          <%
            const TB_COLORS = [
              ['#1d4ed8','Blue'],['#0284c7','Sky Blue'],['#16a34a','Green'],['#059669','Emerald'],
              ['#7c3aed','Purple'],['#ea580c','Orange'],['#db2777','Pink'],['#dc2626','Red'],
              ['#374151','Slate'],['#d97706','Amber']
            ];
          %>
          <div style="display:flex;gap:5px;flex-wrap:wrap;max-width:200px;">
            <% TB_COLORS.forEach(([hex,label],ci)=>{ %>
            <button type="button" class="color-swatch" data-color="<%= hex %>" title="<%= label %>"
              onclick="pickColor('<%= hex %>',this)"
              style="width:26px;height:26px;border-radius:50%;background:<%= hex %>;border:<%= ci===0?'3px solid #111':'3px solid transparent' %>;cursor:pointer;transition:.15s;flex-shrink:0;"></button>
            <% }) %>
          </div>
        </div>
      </div>

      <div style="display:flex;gap:10px;">
        <button type="submit" class="btn btn-primary" id="tb_save" style="flex:1;" disabled>Save Team</button>
        <button type="button" class="btn btn-outline" onclick="resetBuilder()">Clear</button>
        <button type="button" class="btn btn-outline" onclick="toggleBuilder()">Hide</button>
      </div>
    </form>
  </div>
  <% } %>
</div>
<% } %>

<script>
// ── Team Builder ──────────────────────────────────────────────────────────
const tbSlots = {1:{id:null,name:null}, 2:{id:null,name:null}};
let tbDragging = null;

function toggleBuilder(btn){
  const el = document.getElementById('teamBuilder');
  if(!el) return;
  const open = el.style.display !== 'none';
  el.style.display = open ? 'none' : 'block';
}

document.querySelectorAll('.player-chip').forEach(chip => {
  chip.addEventListener('dragstart', e => {
    tbDragging = chip;
    chip.style.opacity = '0.45';
    e.dataTransfer.effectAllowed = 'copy';
  });
  chip.addEventListener('dragend', () => {
    if(tbDragging) tbDragging.style.opacity = '1';
    tbDragging = null;
    document.querySelectorAll('.team-slot').forEach(s => { s.style.borderColor='var(--gray-300)'; s.style.background=''; });
  });
});

function slotOver(e, slot){ e.preventDefault(); slot.style.borderColor='#1d4ed8'; slot.style.background='#eff6ff'; }
function slotLeave(slot){ slot.style.borderColor='var(--gray-300)'; slot.style.background=''; }

function slotDrop(e, slot){
  e.preventDefault();
  if(!tbDragging) return;
  const n = parseInt(slot.dataset.slot);
  const other = n===1 ? 2 : 1;
  const pid = tbDragging.dataset.id, pname = tbDragging.dataset.name;

  if(tbSlots[other].id === pid){
    slot.style.borderColor='#dc2626'; slot.style.background='#fee2e2';
    setTimeout(()=>{ slot.style.borderColor='var(--gray-300)'; slot.style.background=''; }, 700);
    return;
  }
  tbSlots[n] = {id:pid, name:pname};
  document.getElementById('tb_p'+n+'id').value = pid;
  slot.style.borderColor='#16a34a'; slot.style.background='#f0fdf4';
  slot.innerHTML = `<div style="display:flex;align-items:center;gap:8px;width:100%;">
    <span style="font-size:13px;font-weight:600;color:#166534;flex:1;">${pname}</span>
    <button type="button" onclick="clearSlot(${n})" style="background:none;border:none;color:#dc2626;cursor:pointer;font-size:16px;line-height:1;padding:0;">✕</button>
  </div>`;
  tbRefresh();
}

function clearSlot(n){
  tbSlots[n] = {id:null,name:null};
  document.getElementById('tb_p'+n+'id').value = '';
  const slot = document.getElementById('slot'+n);
  slot.innerHTML = `<span style="color:var(--gray-400);font-size:13px;pointer-events:none;">Drop Player ${n} here</span>`;
  slot.style.borderColor='var(--gray-300)'; slot.style.background='';
  tbRefresh();
}

function tbRefresh(){
  const ok = tbSlots[1].id && tbSlots[2].id && tbSlots[1].id !== tbSlots[2].id;
  document.getElementById('tb_save').disabled = !ok;
  if(ok){
    const f = document.getElementById('tb_name');
    if(!f.value.trim()) f.value = tbSlots[1].name.split(' ')[0]+' & '+tbSlots[2].name.split(' ')[0];
  }
}

function pickColor(hex, btn){
  document.querySelectorAll('.color-swatch').forEach(s => s.style.border='3px solid transparent');
  btn.style.border = '3px solid #111';
  document.getElementById('tb_color').value = hex;
  // tint the slots
  ['slot1','slot2'].forEach(id=>{
    const s = document.getElementById(id);
    if(tbSlots[parseInt(id.slice(-1))].id) s.style.borderColor = hex;
  });
}

function resetBuilder(){
  clearSlot(1); clearSlot(2);
  document.getElementById('tb_name').value = '';
  document.getElementById('tb_color').value = '#1d4ed8';
  document.querySelectorAll('.color-swatch').forEach((s,i)=>s.style.border=i===0?'3px solid #111':'3px solid transparent');
}
</script>

<!-- ── Pools Section ──────────────────────────────────────────────────────── -->
<% if(isCreator ? (league.status !== 'active' || _pools.length === 0) : (_pools.length > 0 && league.status !== 'active')){ %>
<div class="card" id="pools" style="margin-bottom:20px;">
  <div class="card-header" style="margin-bottom:14px;">
    <div class="card-title">🏊 Player Pools</div>
    <% if(isCreator){ %>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button type="button" class="btn btn-outline btn-sm" onclick="pbAddPool()">+ Add Pool</button>
      <button type="button" class="btn btn-primary btn-sm" onclick="pbSave()">💾 Save Pools</button>
      <% if(league.status==='draft'){ %>
      <button type="button" class="btn btn-primary btn-sm" style="background:#059669;border-color:#059669;" onclick="pbSaveAndStart()">🚀 Save & Start League</button>
      <% } %>
    </div>
    <% } %>
  </div>

  <% if(!isCreator){ %>
  <!-- Read-only grid for members -->
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;">
    <% _pools.forEach(pool=>{ %>
    <%
      const _allTeams = isDoublesCat&&typeof teams!=='undefined'?teams:[];
      const _memberIds = new Set(pool.poolMembers.map(m=>m.id));
      const _poolTeams = _allTeams.filter(t=>_memberIds.has(t.player1_id)&&_memberIds.has(t.player2_id));
      const _teamedIds = new Set(_poolTeams.flatMap(t=>[t.player1_id,t.player2_id]));
      const _soloMembers = pool.poolMembers.filter(m=>!_teamedIds.has(m.id));
    %>
    <div style="border:2px solid <%= pool.color %>;border-radius:10px;overflow:hidden;">
      <div style="background:<%= pool.color %>;padding:8px 14px;display:flex;justify-content:space-between;align-items:center;">
        <span style="color:#fff;font-weight:700;font-size:14px;"><%= pool.name %></span>
        <% if(isDoublesCat&&_poolTeams.length>0){ %>
        <span style="color:rgba(255,255,255,.75);font-size:12px;"><%= _poolTeams.length %> team<%= _poolTeams.length!==1?'s':'' %></span>
        <% } else { %>
        <span style="color:rgba(255,255,255,.75);font-size:12px;"><%= pool.poolMembers.length %> player<%= pool.poolMembers.length!==1?'s':'' %></span>
        <% } %>
      </div>
      <div style="padding:8px 12px;">
        <% if(pool.poolMembers.length===0){ %>
        <div style="font-size:12px;color:var(--gray-400);font-style:italic;padding:4px 0;">Empty</div>
        <% } %>
        <% if(isDoublesCat){ %>
          <% _poolTeams.forEach(t=>{ %>
          <div style="border:2px solid <%= t.color %>;border-radius:8px;padding:5px 10px;margin-bottom:6px;">
            <div style="font-weight:700;color:<%= t.color %>;font-size:11px;margin-bottom:3px;text-transform:uppercase;letter-spacing:.03em;"><%= t.name %></div>
            <div style="font-size:13px;color:var(--gray-700);">
              <a href="/leagues/<%= league.id %>/player/<%= t.player1_id %>" style="color:var(--gray-700);text-decoration:none;font-weight:500;"><%= t.p1full||t.p1name %></a>
              <span style="color:var(--gray-400);"> &amp; </span>
              <a href="/leagues/<%= league.id %>/player/<%= t.player2_id %>" style="color:var(--gray-700);text-decoration:none;font-weight:500;"><%= t.p2full||t.p2name %></a>
            </div>
          </div>
          <% }) %>
          <% _soloMembers.forEach(m=>{ %>
          <div style="font-size:13px;padding:4px 0;border-bottom:1px solid var(--gray-100);">
            <a href="/leagues/<%= league.id %>/player/<%= m.id %>" style="color:var(--gray-700);text-decoration:none;font-weight:500;"><%= m.full_name||m.username %></a>
          </div>
          <% }) %>
        <% } else { %>
          <% pool.poolMembers.forEach(m=>{ %>
          <div style="font-size:13px;padding:4px 0;border-bottom:1px solid var(--gray-100);">
            <a href="/leagues/<%= league.id %>/player/<%= m.id %>" style="color:var(--gray-700);text-decoration:none;font-weight:500;"><%= m.full_name||m.username %></a>
          </div>
          <% }) %>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>

  <% } else { %>
  <!-- ── Interactive builder (creator only) ── -->
  <!-- Unassigned players zone -->
  <div style="margin-bottom:16px;">
    <div style="font-size:11px;font-weight:600;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;"><%= isDoublesCat ? 'Unassigned Teams — drag into a pool' : 'Unassigned Players — drag into a pool' %></div>
    <div id="pb-avail" class="pb-dzone" data-zone="avail"
      style="display:flex;flex-wrap:wrap;gap:8px;min-height:52px;padding:10px;background:var(--gray-50);border:2px dashed var(--gray-200);border-radius:8px;transition:.15s;"></div>
  </div>
  <!-- Pool cards grid -->
  <div id="pb-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;margin-bottom:16px;"></div>
  <!-- Empty state hint -->
  <div id="pb-hint" style="display:none;text-align:center;padding:28px;color:var(--gray-400);font-size:13px;border:2px dashed var(--gray-200);border-radius:8px;">
    Click <strong>+ Add Pool</strong> to create your first pool, then drag players into it.
  </div>
  <!-- Hidden save form -->
  <form id="pb-form" method="POST" action="/leagues/<%= league.id %>/pools/save">
    <input type="hidden" id="pb-json" name="pools_json"/>
    <input type="hidden" id="pb-start-after-save" name="start_after_save" value=""/>
  </form>
  <% } %>
</div>

<script>
(function(){
  if(!document.getElementById('pb-avail')) return; // non-creator — skip
  const PB_COLORS=[
    {h:'#1d4ed8',l:'Blue'},{h:'#0284c7',l:'Sky'},{h:'#16a34a',l:'Green'},{h:'#059669',l:'Emerald'},
    {h:'#7c3aed',l:'Purple'},{h:'#ea580c',l:'Orange'},{h:'#db2777',l:'Pink'},{h:'#dc2626',l:'Red'},
    {h:'#0d9488',l:'Teal'},{h:'#d97706',l:'Amber'},{h:'#374151',l:'Slate'},{h:'#7c2d12',l:'Brown'}
  ];
  const PB_NAMES=['Pool A','Pool B','Pool C','Pool D','Pool E','Pool F','Pool G','Pool H'];
  // Seed data from server
  const PB_INIT=<%- JSON.stringify(_pools.map((p,i)=>({id:i+1,name:p.name,color:p.color,players:p.poolMembers.map(m=>({id:m.id,name:m.full_name||m.username}))}))).replace(/<\//g,'<\\/') %>;
  const PB_ALL=<%- JSON.stringify(members.map(m=>({id:m.id,name:m.full_name||m.username}))).replace(/<\//g,'<\\/') %>;
  const PB_TEAMS=<%- JSON.stringify(isDoublesCat?(typeof teams!=='undefined'?teams:[]).map(t=>({id:t.id,name:t.name,color:t.color,p1id:t.player1_id,p1name:t.p1full||t.p1name,p2id:t.player2_id,p2name:t.p2full||t.p2name})):[]).replace(/<\//g,'<\\/') %>;
  const isDoublesPool=<%- isDoublesCat?'true':'false' %>;
  const teamedSet=new Set(PB_TEAMS.flatMap(t=>[t.p1id,t.p2id]));

  let pools=PB_INIT.map(p=>({...p}));
  let nextId=pools.length+1;
  let drag=null;

  // Infer team→pool assignments from existing saved pool data
  let teamAssignments={};
  PB_TEAMS.forEach(t=>{
    let found=null;
    for(const p of pools){
      if(p.players.find(pl=>pl.id===t.p1id)&&p.players.find(pl=>pl.id===t.p2id)){found=p.id;break;}
    }
    teamAssignments[t.id]=found!==null?found:'avail';
  });

  /* ── helpers ── */
  function assigned(){
    const s=new Set();
    if(isDoublesPool){
      PB_TEAMS.forEach(t=>{if(teamAssignments[t.id]!=='avail'){s.add(t.p1id);s.add(t.p2id);}});
      pools.forEach(p=>p.players.forEach(pl=>{if(!teamedSet.has(pl.id))s.add(pl.id);}));
    } else {
      pools.forEach(p=>p.players.forEach(pl=>s.add(pl.id)));
    }
    return s;
  }

  function chip(player,zone){
    const d=document.createElement('div');
    d.draggable=true; d.dataset.pid=player.id; d.dataset.pname=player.name; d.dataset.zone=zone; d.dataset.type='player';
    d.style.cssText='padding:5px 13px;border-radius:999px;background:var(--gray-100);color:var(--gray-700);font-size:13px;font-weight:500;cursor:grab;user-select:none;border:2px solid var(--gray-200);white-space:nowrap;transition:.1s;';
    d.textContent=player.name;
    d.addEventListener('dragstart',e=>{drag=d;d.style.opacity='.35';e.dataTransfer.effectAllowed='move';});
    d.addEventListener('dragend',()=>{if(drag)drag.style.opacity='1';drag=null;clearHighlights();});
    return d;
  }

  function teamChip(team,zone){
    const d=document.createElement('div');
    d.draggable=true; d.dataset.type='team'; d.dataset.tid=team.id;
    d.dataset.p1id=team.p1id; d.dataset.p1name=team.p1name;
    d.dataset.p2id=team.p2id; d.dataset.p2name=team.p2name;
    d.dataset.zone=zone;
    d.style.cssText=`padding:7px 12px;border-radius:10px;background:#fff;border:2px solid ${team.color};cursor:grab;user-select:none;transition:.1s;min-width:140px;position:relative;`;
    d.innerHTML=`<div style="font-weight:700;color:${team.color};font-size:12px;margin-bottom:2px;pointer-events:none;">${team.name}</div><div style="font-size:12px;color:var(--gray-600);pointer-events:none;">${team.p1name} &amp; ${team.p2name}</div>`;
    d.addEventListener('dragstart',e=>{drag=d;d.style.opacity='.35';e.dataTransfer.effectAllowed='move';});
    d.addEventListener('dragend',()=>{if(drag)drag.style.opacity='1';drag=null;clearHighlights();});
    return d;
  }

  function clearHighlights(){
    document.querySelectorAll('.pb-dzone').forEach(z=>{z.style.outline='';z.style.background='';});
  }

  function dropZone(el){
    el.addEventListener('dragover',e=>{e.preventDefault();el.style.outline='2px solid #1d4ed8';el.style.background='#eff6ff';});
    el.addEventListener('dragleave',e=>{if(!el.contains(e.relatedTarget)){el.style.outline='';el.style.background='';}});
    el.addEventListener('drop',e=>{
      e.preventDefault();el.style.outline='';el.style.background='';
      if(!drag)return;
      const from=drag.dataset.zone,to=el.dataset.zone;
      if(from===to)return;
      if(drag.dataset.type==='team'){
        const tid=parseInt(drag.dataset.tid);
        const p1id=parseInt(drag.dataset.p1id),p1name=drag.dataset.p1name;
        const p2id=parseInt(drag.dataset.p2id),p2name=drag.dataset.p2name;
        if(from!=='avail'){const sp=pools.find(p=>String(p.id)===from);if(sp)sp.players=sp.players.filter(pl=>pl.id!==p1id&&pl.id!==p2id);}
        if(to!=='avail'){
          const dp=pools.find(p=>String(p.id)===to);
          if(dp){
            if(!dp.players.find(pl=>pl.id===p1id))dp.players.push({id:p1id,name:p1name});
            if(!dp.players.find(pl=>pl.id===p2id))dp.players.push({id:p2id,name:p2name});
          }
        }
        teamAssignments[tid]=to==='avail'?'avail':parseInt(to);
      } else {
        const pid=parseInt(drag.dataset.pid),pname=drag.dataset.pname;
        if(from!=='avail'){const sp=pools.find(p=>String(p.id)===from);if(sp)sp.players=sp.players.filter(pl=>pl.id!==pid);}
        if(to!=='avail'){const dp=pools.find(p=>String(p.id)===to);if(dp&&!dp.players.find(pl=>pl.id===pid))dp.players.push({id:pid,name:pname});}
      }
      render();
    });
  }

  /* ── render ── */
  function render(){renderAvail();renderGrid();}

  function renderAvail(){
    const z=document.getElementById('pb-avail');
    z.innerHTML='';
    if(isDoublesPool){
      const unTeams=PB_TEAMS.filter(t=>teamAssignments[t.id]==='avail');
      const soloFree=PB_ALL.filter(m=>!teamedSet.has(m.id)&&!assigned().has(m.id));
      if(unTeams.length===0&&soloFree.length===0){
        const s=document.createElement('span');s.style.cssText='color:var(--gray-400);font-size:13px;';s.textContent='All teams assigned';z.appendChild(s);
      } else {
        unTeams.forEach(t=>z.appendChild(teamChip(t,'avail')));
        soloFree.forEach(m=>z.appendChild(chip(m,'avail')));
      }
    } else {
      const free=PB_ALL.filter(m=>!assigned().has(m.id));
      if(free.length===0){const s=document.createElement('span');s.style.cssText='color:var(--gray-400);font-size:13px;';s.textContent='All players assigned';z.appendChild(s);}
      else free.forEach(m=>z.appendChild(chip(m,'avail')));
    }
  }

  function renderGrid(){
    const g=document.getElementById('pb-grid');
    g.innerHTML='';
    const hint=document.getElementById('pb-hint');
    if(hint)hint.style.display=pools.length===0?'block':'none';
    pools.forEach(p=>g.appendChild(makeCard(p)));
  }

  function makeCard(pool){
    const card=document.createElement('div');
    card.style.cssText=`border:2px solid ${pool.color};border-radius:10px;overflow:hidden;`;
    // Header
    const hdr=document.createElement('div');
    hdr.style.cssText=`background:${pool.color};padding:8px 12px;display:flex;align-items:center;gap:8px;`;
    const inp=document.createElement('input');
    inp.type='text';inp.value=pool.name;
    inp.style.cssText='background:transparent;border:none;color:#fff;font-weight:700;font-size:14px;flex:1;outline:none;min-width:0;';
    inp.addEventListener('input',()=>{pool.name=inp.value;});
    const xbtn=document.createElement('button');
    xbtn.type='button';xbtn.innerHTML='✕';
    xbtn.style.cssText='background:rgba(255,255,255,.25);border:none;color:#fff;cursor:pointer;border-radius:4px;padding:1px 7px;font-size:13px;flex-shrink:0;';
    xbtn.onclick=()=>{
      if(isDoublesPool){PB_TEAMS.forEach(t=>{if(teamAssignments[t.id]===pool.id)teamAssignments[t.id]='avail';});}
      pools=pools.filter(p=>p.id!==pool.id);render();
    };
    hdr.appendChild(inp);hdr.appendChild(xbtn);
    // Body
    const body=document.createElement('div');
    body.style.cssText='padding:10px;background:#fff;';
    // Color swatches
    const swrow=document.createElement('div');
    swrow.style.cssText='display:flex;gap:4px;flex-wrap:wrap;margin-bottom:10px;';
    PB_COLORS.forEach(({h,l})=>{
      const sw=document.createElement('button');sw.type='button';sw.title=l;
      sw.style.cssText=`width:18px;height:18px;border-radius:50%;background:${h};border:${h===pool.color?'2.5px solid #111':'2.5px solid transparent'};cursor:pointer;flex-shrink:0;transition:.1s;`;
      sw.onclick=()=>{pool.color=h;card.style.borderColor=h;hdr.style.background=h;swrow.querySelectorAll('button').forEach(b=>b.style.border='2.5px solid transparent');sw.style.border='2.5px solid #111';};
      swrow.appendChild(sw);
    });
    body.appendChild(swrow);
    // Count badge
    const badge=document.createElement('div');
    badge.style.cssText='font-size:11px;color:var(--gray-400);margin-bottom:8px;';
    if(isDoublesPool){
      const tc=PB_TEAMS.filter(t=>teamAssignments[t.id]===pool.id).length;
      const sc=pool.players.filter(pl=>!teamedSet.has(pl.id)).length;
      badge.textContent=tc+(tc!==1?' teams':' team')+(sc>0?', '+sc+' solo'+(sc!==1?' players':' player'):'');
    } else {
      badge.textContent=pool.players.length+' player'+(pool.players.length!==1?'s':'');
    }
    body.appendChild(badge);
    // Drop zone
    const dz=document.createElement('div');
    dz.className='pb-dzone';dz.dataset.zone=pool.id;
    dz.style.cssText='min-height:60px;border:2px dashed var(--gray-200);border-radius:8px;padding:8px;display:flex;flex-wrap:wrap;gap:6px;align-content:flex-start;transition:.15s;';
    const poolTeams=isDoublesPool?PB_TEAMS.filter(t=>teamAssignments[t.id]===pool.id):[];
    const soloInPool=isDoublesPool?pool.players.filter(pl=>!teamedSet.has(pl.id)):pool.players;
    if(poolTeams.length===0&&soloInPool.length===0){
      const hint=document.createElement('span');
      hint.style.cssText='color:var(--gray-400);font-size:12px;width:100%;text-align:center;padding:10px 0;pointer-events:none;';
      hint.textContent=isDoublesPool?'Drop teams here':'Drop players here';dz.appendChild(hint);
    } else {
      poolTeams.forEach(t=>{
        const tc=teamChip(t,String(pool.id));
        const rb=document.createElement('button');rb.type='button';rb.textContent='✕';
        rb.style.cssText='position:absolute;top:5px;right:7px;background:none;border:none;color:var(--gray-400);cursor:pointer;font-size:11px;padding:0;line-height:1;';
        rb.onclick=e=>{e.stopPropagation();pool.players=pool.players.filter(p=>p.id!==t.p1id&&p.id!==t.p2id);teamAssignments[t.id]='avail';render();};
        tc.appendChild(rb);dz.appendChild(tc);
      });
      soloInPool.forEach(pl=>{
        const c=chip(pl,String(pool.id));
        const rb=document.createElement('button');rb.type='button';rb.textContent='✕';
        rb.style.cssText='background:none;border:none;color:var(--gray-400);cursor:pointer;font-size:12px;margin-left:4px;padding:0;line-height:1;';
        rb.onclick=e=>{e.stopPropagation();pool.players=pool.players.filter(p=>p.id!==pl.id);render();};
        c.appendChild(rb);dz.appendChild(c);
      });
    }
    dropZone(dz);
    body.appendChild(dz);
    card.appendChild(hdr);card.appendChild(body);
    return card;
  }

  /* ── public actions ── */
  window.pbAddPool=function(){
    const name=PB_NAMES[pools.length%PB_NAMES.length];
    const color=PB_COLORS[pools.length%PB_COLORS.length].h;
    pools.push({id:nextId++,name,color,players:[]});
    render();
    document.getElementById('pb-grid').lastElementChild?.scrollIntoView({behavior:'smooth',block:'nearest'});
  };
  window.pbSave=function(){
    document.getElementById('pb-json').value=JSON.stringify(pools.map(p=>({name:p.name,color:p.color,players:p.players.map(pl=>pl.id)})));
    document.getElementById('pb-form').submit();
  };
  window.pbSaveAndStart=function(){
    if(pools.length===0){alert('Add at least one pool before starting the league.');return;}
    document.getElementById('pb-json').value=JSON.stringify(pools.map(p=>({name:p.name,color:p.color,players:p.players.map(pl=>pl.id)})));
    document.getElementById('pb-start-after-save').value='1';
    document.getElementById('pb-form').submit();
  };

  /* ── init ── */
  dropZone(document.getElementById('pb-avail'));
  render();
})();
</script>
<% } %>

