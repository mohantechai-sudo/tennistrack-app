<%
  function fmtDate(d){return new Date(d).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});}
  function fmtDT(d){return new Date(d).toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});}

  const CAT_LABEL={mens_singles:"Men's Singles",mens_doubles:"Men's Doubles",womens_singles:"Women's Singles",womens_doubles:"Women's Doubles",mixed_doubles:"Mixed Doubles",open:"Open"};
  const CAT_ICON ={mens_singles:'👨',mens_doubles:'👬',womens_singles:'👩',womens_doubles:'👭',mixed_doubles:'👫',open:'🎾'};
  const CAT_COLOR={mens_singles:'#1d4ed8',mens_doubles:'#1d4ed8',womens_singles:'#be185d',womens_doubles:'#be185d',mixed_doubles:'#7c3aed',open:'#374151'};
  const CAT_BG   ={mens_singles:'#dbeafe',mens_doubles:'#dbeafe',womens_singles:'#fce7f3',womens_doubles:'#fce7f3',mixed_doubles:'#ede9fe',open:'#f3f4f6'};
  const cat=league.category||'open';
  const isDoublesCat=['mens_doubles','womens_doubles','mixed_doubles'].includes(cat);
  const autoType=isDoublesCat?'doubles':['mens_singles','womens_singles'].includes(cat)?'singles':null;

  const enrollKey=league.enrollment||'open';
  const ENROLL_LABEL={open:'Open',invite_only:'Invite Only',closed:'Closed'};
  const ENROLL_COLOR={open:'var(--green-600)',invite_only:'#1d4ed8',closed:'#dc2626'};
  const playerLimit=plan.playerLimit===9999?'∞':plan.playerLimit;
  const usagePct=plan.playerLimit===9999?0:Math.min(100,Math.round((members.length/plan.playerLimit)*100));

  const isDraft=league.status==='draft';
  const isActive=league.status==='active';
  const isEnded=league.status==='ended';
  const hasPools=pools&&pools.length>0;

  const showBuilder=isCreator;
  const showPools=isActive&&hasPools;
  const showFixtures=isActive;
  const showCalendar=(isMember||isCreator)&&isActive;

  const _ap=acceptedProposals||[];
  const _cp=calProposals||{incoming:[],outgoing:[],accepted:[],all:[]};

  // memberById
  const mById={};members.forEach(m=>{mById[m.id]=m;});
  // teamByPlayer1 (for doubles)
  const tByP1={};
  if(teams)teams.forEach(t=>{tByP1[t.player1_id]=t;});

  // Pool standings + fixtures
  const poolData=(pools||[]).map(pool=>{
    const pmIds=pool.poolMembers.map(m=>m.id);
    const poolMatches=lmatches.filter(lm=>pmIds.includes(lm.player1_id)&&pmIds.includes(lm.player2_id));
    const pStandings=pool.poolMembers.map(pm=>{
      const played=poolMatches.filter(lm=>lm.player1_id===pm.id||lm.player2_id===pm.id||lm.player1_partner_id===pm.id||lm.player2_partner_id===pm.id);
      const wins=played.filter(lm=>{
        if(!lm.winner_id)return false;
        const onT1=lm.player1_id===pm.id||lm.player1_partner_id===pm.id;
        const t1won=lm.winner_id===lm.player1_id||lm.winner_id===lm.player1_partner_id;
        const t2won=lm.winner_id===lm.player2_id||lm.winner_id===lm.player2_partner_id;
        return onT1?t1won:t2won;
      }).length;
      const losses=played.filter(lm=>{
        if(!lm.winner_id)return false;
        const onT1=lm.player1_id===pm.id||lm.player1_partner_id===pm.id;
        const t1won=lm.winner_id===lm.player1_id||lm.winner_id===lm.player1_partner_id;
        const t2won=lm.winner_id===lm.player2_id||lm.winner_id===lm.player2_partner_id;
        return onT1?t2won:t1won;
      }).length;
      return {...pm,played:played.length,wins,losses,points:wins*2};
    }).sort((a,b)=>b.points-a.points||b.wins-a.wins);
    const fixtures=[];
    for(let i=0;i<pool.poolMembers.length;i++){
      for(let j=i+1;j<pool.poolMembers.length;j++){
        const p1=pool.poolMembers[i],p2=pool.poolMembers[j];
        const match=poolMatches.find(lm=>(lm.player1_id===p1.id&&lm.player2_id===p2.id)||(lm.player1_id===p2.id&&lm.player2_id===p1.id));
        const accepted=_ap.find(ap=>(ap.proposer_id===p1.id&&ap.opponent_id===p2.id)||(ap.proposer_id===p2.id&&ap.opponent_id===p1.id));
        const t1=isDoublesCat?tByP1[p1.id]:null;
        const t2=isDoublesCat?tByP1[p2.id]:null;
        fixtures.push({p1,p2,t1,t2,match,accepted});
      }
    }
    return {...pool,pStandings,fixtures,poolMatches};
  });
%>
<%- include('layout_top',{title:league.name,page:'leagues',user}) %>

<% if(error){%><div class="alert alert-error" style="margin-bottom:14px;"><%= error %></div><%}%>
<% if(success){%><div class="alert alert-success" style="margin-bottom:14px;"><%= success %></div><%}%>
<% if(joinErr==='limit'){%><div class="alert alert-error" style="margin-bottom:14px;">⚠️ Player limit reached. Ask the organiser to upgrade the plan.</div><%}%>
<% if(joinErr==='invite_only'){%><div class="alert alert-error" style="margin-bottom:14px;">🔒 Invite only — ask the organiser to send you an invite link.</div><%}%>
<% if(joinErr==='closed'){%><div class="alert alert-error" style="margin-bottom:14px;">🔒 This league is closed to new players.</div><%}%>

<!-- ── League Header ─────────────────────────────────────────────────────── -->
<div class="card league-hero" style="margin-bottom:16px;overflow:hidden;padding:0;border:none;">
  <!-- Gradient banner -->
  <div style="background:linear-gradient(135deg,var(--green-900) 0%,var(--green-700) 55%,<%=plan.color%> 100%);padding:22px 24px 18px;position:relative;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;">
      <div style="flex:1;min-width:0;">
        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:8px;">
          <span style="font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;background:rgba(255,255,255,.18);color:#fff;letter-spacing:.03em;"><%=plan.label%> Plan</span>
          <span style="font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;background:<%=isDraft?'rgba(250,204,21,.25)':isActive?'rgba(74,222,128,.2)':'rgba(156,163,175,.2)'%>;color:#fff;"><%=isDraft?'⚙️ Draft':isActive?'🟢 Active':'⏹ Ended'%></span>
          <span style="font-size:11px;font-weight:600;padding:3px 10px;border-radius:999px;background:rgba(255,255,255,.13);color:rgba(255,255,255,.9);"><%=CAT_ICON[cat]%> <%=CAT_LABEL[cat]%></span>
        </div>
        <h1 style="font-size:26px;font-weight:800;color:#fff;margin:0;letter-spacing:-0.4px;line-height:1.15;"><%= league.name %></h1>
        <% if(league.description){%><div style="font-size:13px;color:rgba(255,255,255,.72);margin-top:5px;"><%=league.description%></div><%}%>
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:9px;">
          <span style="font-size:12px;color:rgba(255,255,255,.65);">📋 <%=league.format==='round_robin'?'Round Robin':'Knockout'%></span>
          <span style="font-size:12px;color:rgba(255,255,255,.65);">👤 @<%=league.creator_name%></span>
          <span style="font-size:12px;color:rgba(255,255,255,.65);">● <%=ENROLL_LABEL[enrollKey]%></span>
        </div>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:flex-start;">
        <a href="/leagues" class="btn btn-sm" style="background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);color:#fff;backdrop-filter:blur(4px);">← All</a>
        <% if(isCreator){%><a href="/leagues/<%=league.id%>/settings" class="btn btn-sm" style="background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);color:#fff;">⚙️ Settings</a><%}%>
        <% if(isCreator&&isDraft){%>
        <form method="POST" action="/leagues/<%=league.id%>/start" style="margin:0;">
          <button class="btn btn-sm" style="background:#fff;color:var(--green-800);font-weight:700;border:none;box-shadow:0 2px 8px rgba(0,0,0,.2);">🚀 Start League</button>
        </form>
        <%}%>
        <% if(!isMember&&isActive&&enrollKey==='open'){%>
        <form method="POST" action="/leagues/<%=league.id%>/join" style="margin:0;">
          <button class="btn btn-sm" style="background:#fff;color:var(--green-800);font-weight:700;border:none;box-shadow:0 2px 8px rgba(0,0,0,.2);">Join League</button>
        </form>
        <%}%>
        <% if(isMember&&!isCreator){%>
        <form method="POST" action="/leagues/<%=league.id%>/leave" style="margin:0;" onsubmit="return confirm('Leave this league?')">
          <button class="btn btn-sm" style="background:rgba(220,38,38,.2);border:1px solid rgba(255,255,255,.2);color:#fca5a5;">Leave</button>
        </form>
        <%}%>
        <% if(isCreator&&isActive){%>
        <form method="POST" action="/leagues/<%=league.id%>/end" style="margin:0;" onsubmit="return confirm('End league? This cannot be undone.')">
          <button class="btn btn-sm" style="background:rgba(220,38,38,.2);border:1px solid rgba(255,255,255,.2);color:#fca5a5;">End</button>
        </form>
        <%}%>
      </div>
    </div>
  </div>
  <!-- Stats bar -->
  <div style="padding:12px 24px;display:flex;align-items:center;gap:0;background:#fff;border-top:none;">
    <div style="display:flex;align-items:center;gap:0;flex:1;flex-wrap:wrap;">
      <div style="text-align:center;padding:4px 20px 4px 0;">
        <div style="font-size:22px;font-weight:800;color:var(--green-700);line-height:1;"><%=members.length%></div>
        <div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;letter-spacing:.06em;margin-top:2px;">Players</div>
      </div>
      <div style="width:1px;height:30px;background:var(--gray-150,#eff0f2);margin-right:20px;"></div>
      <div style="text-align:center;padding:4px 20px 4px 0;">
        <div style="font-size:22px;font-weight:800;color:var(--green-700);line-height:1;"><%=lmatches.length%></div>
        <div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;letter-spacing:.06em;margin-top:2px;">Matches</div>
      </div>
      <div style="width:1px;height:30px;background:var(--gray-150,#eff0f2);margin-right:20px;"></div>
      <div style="text-align:center;padding:4px 20px 4px 0;">
        <div style="font-size:22px;font-weight:800;color:var(--green-700);line-height:1;"><%=playerLimit%></div>
        <div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;letter-spacing:.06em;margin-top:2px;">Max Players</div>
      </div>
      <% if(plan.playerLimit!==9999){%>
      <div style="width:1px;height:30px;background:var(--gray-150,#eff0f2);margin-right:20px;"></div>
      <div style="padding:4px 0;flex:1;min-width:120px;max-width:220px;">
        <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--gray-400);margin-bottom:5px;">
          <span>Capacity</span><span style="font-weight:700;color:var(--gray-700);"><%=members.length%>/<%=plan.playerLimit%></span>
        </div>
        <div style="background:var(--gray-100);border-radius:999px;height:5px;overflow:hidden;">
          <div style="width:<%=usagePct%>%;height:100%;background:<%=usagePct>=90?'#dc2626':usagePct>=70?'#d97706':plan.color%>;border-radius:999px;transition:.4s;"></div>
        </div>
      </div>
      <%}%>
    </div>
    <% if(isCreator&&plan.label!=='Premium'){%><a href="/leagues/<%=league.id%>/settings#plans" style="font-size:12px;color:<%=plan.color%>;font-weight:600;white-space:nowrap;margin-left:12px;">Upgrade →</a><%}%>
  </div>
</div>

<!-- ── Tab Navigation ────────────────────────────────────────────────────── -->
<div class="ld-tabs" id="ldTabNav" style="display:flex;gap:2px;flex-wrap:wrap;margin-bottom:16px;background:var(--gray-100);border-radius:var(--radius);padding:4px;">
  <button class="ld-tab" data-tab="overview" onclick="ldTab('overview')">📊 Overview</button>
  <button class="ld-tab" data-tab="dashboard" onclick="ldTab('dashboard')">📈 Stats</button>
  <% if(showBuilder){%><button class="ld-tab" data-tab="builder" onclick="ldTab('builder')">🏗️ Builder</button><%}%>
  <% if(showPools){%><button class="ld-tab" data-tab="pools" onclick="ldTab('pools')">🏊 Pools</button><%}%>
  <% if(showFixtures){%><button class="ld-tab" data-tab="matches" onclick="ldTab('matches')">🎾 Matches</button><%}%>
  <% if(showCalendar){%><button class="ld-tab" data-tab="calendar" onclick="ldTab('calendar')">📅 Calendar</button><%}%>
  <button class="ld-tab" data-tab="players" onclick="ldTab('players')">👥 Players</button>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     TAB 1 — OVERVIEW
     ══════════════════════════════════════════════════════════════════════════ -->
<div id="tab-overview" class="ld-panel">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;" class="ov-grid">

    <!-- Standings -->
    <div class="card" style="padding:0;overflow:hidden;">
      <div class="card-header" style="padding:14px 16px 12px;">
        <div class="card-title">🏆 <%=isDoublesCat?'Team ':''%>Standings</div>
        <span style="font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--green-50);color:var(--green-700);">W = 2 pts</span>
      </div>
      <%
        const displayStandings = isDoublesCat && teamStandings ? teamStandings : standings;
        const RANK_MEDALS = ['🥇','🥈','🥉'];
      %>
      <% if(!displayStandings||displayStandings.length===0){%>
      <div class="empty-state" style="padding:32px;"><div class="empty-icon">📊</div><div class="empty-text">No matches recorded yet</div></div>
      <% }else{%>
      <table style="width:100%;border-collapse:collapse;font-size:13px;">
        <thead><tr style="background:var(--gray-50);color:var(--gray-400);">
          <th style="text-align:left;padding:7px 8px 7px 16px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.05em;">#</th>
          <th style="text-align:left;padding:7px 8px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.05em;"><%=isDoublesCat?'Team':'Player'%></th>
          <th style="text-align:center;padding:7px 8px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.05em;">P</th>
          <th style="text-align:center;padding:7px 8px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.05em;">W</th>
          <th style="text-align:center;padding:7px 8px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.05em;">L</th>
          <th style="text-align:center;padding:7px 16px 7px 8px;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.05em;">Pts</th>
        </tr></thead>
        <tbody>
        <% displayStandings.forEach((s,i)=>{
             const isMe = isDoublesCat ? (s.ids&&s.ids.includes(uid)) : s.id===uid;
             const label = isDoublesCat ? s.names.join('/') : (s.full_name||s.username);
             const rankDisplay = RANK_MEDALS[i] || String(i+1);
             const rowBg = isMe ? 'background:var(--green-50);' : i===0 ? 'background:#fffbeb;' : '';
        %>
        <tr style="border-bottom:1px solid var(--gray-100);<%=rowBg%>transition:.12s;" onmouseover="this.style.background='var(--gray-50)'" onmouseout="this.style.background='<%=isMe?'var(--green-50)':i===0?'#fffbeb':''%>'">
          <td style="padding:10px 8px 10px 16px;font-size:<%=i<3?'15px':'13px'%>;"><%=rankDisplay%></td>
          <td style="padding:10px 8px;font-weight:<%=isMe?700:500%>;color:<%=isMe?'var(--green-700)':'var(--gray-800)'%>;">
            <%=label%><% if(isMe){%> <span style="font-size:10px;font-weight:600;padding:1px 5px;border-radius:999px;background:var(--green-100);color:var(--green-700);margin-left:4px;">you</span><%}%>
          </td>
          <td style="text-align:center;padding:10px 8px;color:var(--gray-400);font-size:12px;"><%=s.played%></td>
          <td style="text-align:center;padding:10px 8px;color:var(--green-600);font-weight:700;"><%=s.wins%></td>
          <td style="text-align:center;padding:10px 8px;color:#ef4444;font-weight:600;"><%=s.losses%></td>
          <td style="text-align:center;padding:10px 16px 10px 8px;font-weight:800;font-size:15px;color:<%=i===0?'var(--green-700)':'var(--gray-800)'%>;"><%=s.points%></td>
        </tr>
        <%})%>
        </tbody>
      </table>
      <%}%>
    </div>

    <!-- Recent matches -->
    <div class="card" style="padding:0;overflow:hidden;">
      <div class="card-header" style="padding:14px 16px 12px;">
        <div class="card-title">🎾 Recent Matches</div>
        <span style="font-size:11px;color:var(--gray-400);">Last 5</span>
      </div>
      <% if(lmatches.length===0){%>
      <div class="empty-state" style="padding:32px;"><div class="empty-icon">🎾</div><div class="empty-text">No matches recorded yet</div></div>
      <%}else{%>
      <div>
        <% lmatches.slice(0,5).forEach(m=>{
             const isD=m.match_type==='doubles';
             const onT1=m.player1_id===uid||m.player1_partner_id===uid;
             const onT2=m.player2_id===uid||m.player2_partner_id===uid;
             const involved=onT1||onT2;
             const t1won=m.winner_id&&(m.winner_id===m.player1_id||m.winner_id===m.player1_partner_id);
             const t2won=m.winner_id&&(m.winner_id===m.player2_id||m.winner_id===m.player2_partner_id);
             const myWin=involved&&((onT1&&t1won)||(onT2&&t2won));
             const oc=myWin?'win':(involved&&m.winner_id?'loss':'nr');
             const t1l=isD&&m.p1partnername?`${m.p1name}/${m.p1partnername}`:m.p1name;
             const t2l=isD&&m.p2partnername?`${m.p2name}/${m.p2partnername}`:m.p2name;
             const accentColor=oc==='win'?'var(--green-500)':oc==='loss'?'#ef4444':'var(--gray-200)';
        %>
        <div style="display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid var(--gray-50);border-left:3px solid <%=accentColor%>;">
          <% if(involved){%>
          <div style="width:28px;height:28px;border-radius:8px;background:<%=oc==='win'?'var(--green-100)':oc==='loss'?'#fee2e2':'var(--gray-100)'%>;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:<%=oc==='win'?'var(--green-700)':oc==='loss'?'#dc2626':'var(--gray-400)'%>;flex-shrink:0;"><%=oc==='win'?'W':oc==='loss'?'L':'–'%></div>
          <%}else{%><div style="width:28px;text-align:center;font-size:16px;flex-shrink:0;">🎾</div><%}%>
          <div style="flex:1;min-width:0;">
            <div style="font-size:13px;font-weight:600;color:var(--gray-800);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><strong><%=t1l%></strong> <span style="color:var(--gray-400);font-weight:400;">vs</span> <strong><%=t2l%></strong></div>
            <div style="font-size:11px;color:var(--gray-400);margin-top:1px;"><%=fmtDate(m.played_at)%><% if(m.winnername){%> · 🏆 <%=m.winnername%><%}%></div>
          </div>
          <div style="text-align:right;flex-shrink:0;">
            <div style="font-size:13px;font-weight:700;color:var(--gray-700);"><%=m.score%></div>
            <span style="font-size:10px;padding:1px 5px;border-radius:999px;background:<%=isD?'#ede9fe':'#dcfce7'%>;color:<%=isD?'#7c3aed':'#166534'%>;"><%=isD?'Dbl':'Sgl'%></span>
          </div>
        </div>
        <%})%>
      </div>
      <% if(lmatches.length>5){%>
      <div style="padding:10px 16px;">
        <button class="btn btn-outline btn-sm btn-full" onclick="ldTab('dashboard')">View all <%=lmatches.length%> matches →</button>
      </div>
      <%}%>
      <%}%>
    </div>
  </div>

  <!-- Draft status info -->
  <% if(isDraft){%>
  <div class="card" style="margin-top:16px;border:2px dashed #fef08a;background:#fefce8;">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
      <div style="font-size:28px;">🏗️</div>
      <div style="flex:1;">
        <div style="font-weight:700;color:#854d0e;font-size:14px;">League is in Draft mode</div>
        <div style="font-size:13px;color:#92400e;margin-top:2px;">
          <% if(isCreator){%>Use the <strong>Builder</strong> tab to set up teams and pools, then start the league.<%}else{%>The organiser is building the league structure. Join now — play begins when it goes active.<%}%>
        </div>
      </div>
      <% if(isCreator){%>
      <button class="btn btn-sm" style="background:#ca8a04;color:#fff;border:none;" onclick="ldTab('builder')">Open Builder →</button>
      <%}%>
    </div>
  </div>
  <%}%>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     TAB 2 — DASHBOARD
     ══════════════════════════════════════════════════════════════════════════ -->
<div id="tab-dashboard" class="ld-panel" style="display:none;">
  <%
    const myRank=standings.findIndex(s=>s.id===uid);
    const mySt=myRank>=0?standings[myRank]:null;
    const sfCounts={};lmatches.forEach(m=>{sfCounts[m.surface]=(sfCounts[m.surface]||0)+1;});
    const topSf=Object.entries(sfCounts).sort((a,b)=>b[1]-a[1])[0];
  %>
  <!-- Stat cards -->
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;margin-bottom:16px;">
    <div class="card" style="padding:0;overflow:hidden;">
      <div style="height:4px;background:linear-gradient(90deg,#1d4ed8,#3b82f6);"></div>
      <div style="padding:14px 12px;text-align:center;">
        <div style="font-size:28px;font-weight:800;color:var(--gray-800);line-height:1;"><%=lmatches.length%></div>
        <div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;margin-top:4px;">Matches Played</div>
      </div>
    </div>
    <div class="card" style="padding:0;overflow:hidden;">
      <div style="height:4px;background:linear-gradient(90deg,#7c3aed,#a78bfa);"></div>
      <div style="padding:14px 12px;text-align:center;">
        <div style="font-size:28px;font-weight:800;color:var(--gray-800);line-height:1;"><%=members.length%></div>
        <div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;margin-top:4px;">Players</div>
      </div>
    </div>
    <% if(isMember&&mySt){%>
    <div class="card" style="padding:0;overflow:hidden;">
      <div style="height:4px;background:linear-gradient(90deg,var(--green-500),var(--green-300));"></div>
      <div style="padding:14px 12px;text-align:center;">
        <div style="font-size:28px;font-weight:800;color:var(--green-700);line-height:1;">#<%=myRank+1%></div>
        <div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;margin-top:4px;">Your Rank</div>
      </div>
    </div>
    <div class="card" style="padding:0;overflow:hidden;">
      <div style="height:4px;background:linear-gradient(90deg,#059669,#34d399);"></div>
      <div style="padding:14px 12px;text-align:center;">
        <div style="font-size:24px;font-weight:800;line-height:1;"><span style="color:var(--green-600);"><%=mySt.wins%></span><span style="font-size:14px;color:var(--gray-300);"> / </span><span style="color:#ef4444;"><%=mySt.losses%></span></div>
        <div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;margin-top:4px;">Win / Loss</div>
      </div>
    </div>
    <%}%>
    <% if(topSf){%>
    <div class="card" style="padding:0;overflow:hidden;">
      <div style="height:4px;background:linear-gradient(90deg,#d97706,#fbbf24);"></div>
      <div style="padding:14px 12px;text-align:center;">
        <div style="font-size:18px;font-weight:800;color:var(--gray-800);text-transform:capitalize;line-height:1.2;"><%=topSf[0]%></div>
        <div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;margin-top:4px;">Top Surface</div>
      </div>
    </div>
    <%}%>
  </div>

  <div style="display:grid;grid-template-columns:1fr;gap:16px;" class="match-tab-grid">
    <!-- Full match history -->
    <div class="card" style="padding:0;overflow:hidden;">
      <div class="card-header" style="padding:14px 16px 12px;"><div class="card-title">Match History</div><span style="font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--gray-100);color:var(--gray-500);"><%=lmatches.length%> matches</span></div>
      <% if(lmatches.length===0){%>
      <div class="empty-state" style="padding:40px;"><div class="empty-icon">🎾</div><div class="empty-text">No matches recorded yet</div></div>
      <%}else{%>
      <div>
        <% lmatches.forEach(m=>{
             const isD=m.match_type==='doubles';
             const onT1=m.player1_id===uid||m.player1_partner_id===uid;
             const onT2=m.player2_id===uid||m.player2_partner_id===uid;
             const involved=onT1||onT2;
             const t1won=m.winner_id&&(m.winner_id===m.player1_id||m.winner_id===m.player1_partner_id);
             const t2won=m.winner_id&&(m.winner_id===m.player2_id||m.winner_id===m.player2_partner_id);
             const myWin=involved&&((onT1&&t1won)||(onT2&&t2won));
             const oc=myWin?'win':(involved&&m.winner_id?'loss':'nr');
             const t1l=isD&&m.p1partnername?`${m.p1name}/${m.p1partnername}`:m.p1name;
             const t2l=isD&&m.p2partnername?`${m.p2name}/${m.p2partnername}`:m.p2name;
             const accentColor2=oc==='win'?'var(--green-500)':oc==='loss'?'#ef4444':'var(--gray-200)';
        %>
        <div style="display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid var(--gray-50);border-left:3px solid <%=accentColor2%>;">
          <% if(involved){%>
          <div style="width:30px;height:30px;border-radius:8px;background:<%=oc==='win'?'var(--green-100)':oc==='loss'?'#fee2e2':'var(--gray-100)'%>;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:<%=oc==='win'?'var(--green-700)':oc==='loss'?'#dc2626':'var(--gray-400)'%>;flex-shrink:0;"><%=oc==='win'?'W':oc==='loss'?'L':'–'%></div>
          <%}else{%><div style="width:30px;text-align:center;font-size:16px;flex-shrink:0;">🎾</div><%}%>
          <div style="flex:1;min-width:0;">
            <div style="font-size:13px;font-weight:600;color:var(--gray-800);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><strong><%=t1l%></strong> <span style="color:var(--gray-400);font-weight:400;">vs</span> <strong><%=t2l%></strong></div>
            <div style="font-size:11px;color:var(--gray-400);margin-top:1px;"><%=fmtDate(m.played_at)%><% if(m.winnername){%> · 🏆 <%=m.winnername%><%}%><% if(m.venue){%> · 📍 <%=m.venue%><%}%></div>
          </div>
          <div style="text-align:right;flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:3px;">
            <div style="font-size:13px;font-weight:700;color:var(--gray-700);"><%=m.score%></div>
            <div style="display:flex;gap:3px;">
              <span class="match-surface surface-<%=m.surface%>" style="font-size:10px;"><%=m.surface%></span>
              <span style="font-size:10px;padding:1px 5px;border-radius:999px;background:<%=isD?'#ede9fe':'#dcfce7'%>;color:<%=isD?'#7c3aed':'#166534'%>;"><%=isD?'Dbl':'Sgl'%></span>
            </div>
          </div>
        </div>
        <%})%>
      </div>
      <%}%>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     TAB 3 — BUILDER (creator + draft or active with no pools)
     ══════════════════════════════════════════════════════════════════════════ -->
<% if(showBuilder){%>
<div id="tab-builder" class="ld-panel" style="display:none;">
<%
  const BLD_PAL=[['#1e40af','#3b82f6'],['#6d28d9','#a78bfa'],['#065f46','#34d399'],['#991b1b','#f87171'],['#92400e','#fbbf24'],['#155e75','#22d3ee'],['#9d174d','#f472b6'],['#1a4731','#6ee7b7']];
  const bldColMap={};members.forEach((m,i)=>{bldColMap[m.id]=BLD_PAL[i%BLD_PAL.length];});
  const bldIni=s=>{const p=(s||'?').trim().split(/\s+/);return p.length>=2?(p[0][0]+p[p.length-1][0]).toUpperCase():(s||'?').substring(0,2).toUpperCase();};
  const bldAsgn=new Set();(pools||[]).forEach(p=>p.poolMembers.forEach(m=>bldAsgn.add(m.id)));
  const bldUnasn=isDoublesCat?(teams||[]).filter(t=>!bldAsgn.has(t.player1_id)):members.filter(m=>!bldAsgn.has(m.id));
  const bldTotal=isDoublesCat?(teams||[]).length:members.length;
  const bldAsgndCnt=bldTotal-bldUnasn.length;
  const bldPct=bldTotal>0?Math.min(100,Math.round(bldAsgndCnt/bldTotal*100)):0;
%>

  <!-- ── Teams section (doubles leagues only) ── -->
  <% if(isDoublesCat){%>
  <div class="card bld-teams-card">
    <div class="card-header">
      <div><div class="card-title">👥 Teams</div><div class="card-sub">Create doubles pairs before building pools</div></div>
      <span style="font-size:11px;font-weight:600;padding:2px 9px;border-radius:999px;background:var(--green-50);color:var(--green-700);"><%=(teams||[]).length%> team<%=(teams||[]).length===1?'':'s'%></span>
    </div>
    <form method="POST" action="/leagues/<%=league.id%>/teams" class="bld-team-form">
      <div class="form-group" style="margin:0;">
        <label class="form-label">Team name</label>
        <input class="form-input" name="name" type="text" placeholder="e.g. Aces"/>
      </div>
      <div class="form-group" style="margin:0;">
        <label class="form-label">Player 1</label>
        <select class="form-input" name="player1_id" required>
          <option value="">— select —</option>
          <%members.forEach(m=>{%><option value="<%=m.id%>"><%=m.full_name||m.username%></option><%})%>
        </select>
      </div>
      <div class="form-group" style="margin:0;">
        <label class="form-label">Player 2</label>
        <select class="form-input" name="player2_id" required>
          <option value="">— select —</option>
          <%members.forEach(m=>{%><option value="<%=m.id%>"><%=m.full_name||m.username%></option><%})%>
        </select>
      </div>
      <div style="align-self:flex-end;"><button type="submit" class="btn btn-primary btn-sm">+ Add Team</button></div>
    </form>
    <% if(teams&&teams.length>0){%>
    <div class="bld-team-cards">
      <% teams.forEach(t=>{
           const tc=t.color||'#1d4ed8';
           const p1n=t.p1full||t.p1name||'?';
           const p2n=t.p2full||t.p2name||'?';
           const p1c=bldColMap[t.player1_id]||BLD_PAL[0];
           const p2c=bldColMap[t.player2_id]||BLD_PAL[1];
      %>
      <div class="bld-team-card">
        <div class="bld-team-bar" style="background:<%=tc%>;"></div>
        <div class="bld-team-body">
          <div class="bld-team-name"><%=t.name%></div>
          <div class="bld-team-players">
            <div class="chip-avatar chip-avatar-sm" style="background:linear-gradient(135deg,<%=p1c[0]%>,<%=p1c[1]%>);"><%=bldIni(p1n)%></div>
            <div class="chip-avatar chip-avatar-sm" style="background:linear-gradient(135deg,<%=p2c[0]%>,<%=p2c[1]%>);"><%=bldIni(p2n)%></div>
            <span class="bld-team-pair"><%=p1n%> / <%=p2n%></span>
          </div>
        </div>
        <form method="POST" action="/leagues/<%=league.id%>/teams/<%=t.id%>/delete" style="margin:0;" onsubmit="return confirm('Delete team?')">
          <button type="submit" class="bld-team-del" title="Delete team">×</button>
        </form>
      </div>
      <%})%>
    </div>
    <%}else{%>
    <div class="empty-state" style="padding:16px 0 4px;"><div class="empty-text" style="font-size:13px;">No teams yet — add at least 2 to build pools</div></div>
    <%}%>
  </div>
  <%}%>

  <!-- ── Pool Builder ── -->
  <div class="card bld-card">

    <!-- Toolbar -->
    <div class="bld-toolbar">
      <div class="bld-toolbar-left">
        <div class="bld-toolbar-title">🏊 Pool Builder</div>
        <div class="bld-toolbar-meta">
          <span id="bldCountLabel" style="font-size:12px;color:var(--gray-500);"><%=bldAsgndCnt%> of <%=bldTotal%> assigned</span>
          <div class="bld-progress-track"><div class="bld-progress-fill" id="bldProgressFill" style="width:<%=bldPct%>%;"></div></div>
        </div>
      </div>
      <div class="bld-toolbar-right">
        <button class="btn btn-outline btn-sm" onclick="ldAddPool()">+ Pool</button>
        <% if(isDraft){%>
        <form method="POST" action="/leagues/<%=league.id%>/pools/save" id="poolSaveForm" style="margin:0;">
          <input type="hidden" name="pools_json" id="poolsJsonInput"/>
          <input type="hidden" name="start_after_save" value="1"/>
          <button type="submit" class="btn btn-primary btn-sm" onclick="return ldSavePools()">🚀 Save & Start</button>
        </form>
        <%}else{%>
        <form method="POST" action="/leagues/<%=league.id%>/pools/save" id="poolSaveForm" style="margin:0;">
          <input type="hidden" name="pools_json" id="poolsJsonInput"/>
          <button type="submit" class="btn btn-primary btn-sm" onclick="return ldSavePools()">💾 Save Pools</button>
        </form>
        <%}%>
      </div>
    </div>

    <!-- Kanban board -->
    <div class="bld-board">

      <!-- Roster (unassigned) -->
      <div class="bld-roster">
        <div class="bld-col-header bld-roster-header">
          <span class="bld-col-dot" style="background:var(--gray-400);"></span>
          <span class="bld-col-name-text">Roster</span>
          <span class="bld-col-badge" id="bldRosterCount"><%=bldUnasn.length%></span>
        </div>
        <div id="ldUnassigned" class="bld-drop-zone" style="min-height:260px;padding:10px;">
          <%if(bldUnasn.length===0){%><div class="bld-empty-hint">All assigned ✓</div><%}%>
          <% bldUnasn.forEach(item=>{
               const bPid=isDoublesCat?item.player1_id:item.id;
               const bLbl=isDoublesCat?item.name:(item.full_name||item.username);
               const bSub=isDoublesCat?`${item.p1full||item.p1name} / ${item.p2full||item.p2name}`:`@${item.username}`;
               const bIni=bldIni(bLbl);
               const bCp=isDoublesCat?(item.color?[item.color,item.color+'bb']:BLD_PAL[0]):(bldColMap[item.id]||BLD_PAL[0]);
          %>
          <div class="ld-chip" draggable="true"
               data-pid="<%=bPid%>" data-label="<%=bLbl%>" data-sub="<%=bSub%>"
               data-ini="<%=bIni%>" data-cf="<%=bCp[0]%>" data-ct="<%=bCp[1]%>">
            <div class="chip-avatar" style="background:linear-gradient(135deg,<%=bCp[0]%>,<%=bCp[1]%>);"><%=bIni%></div>
            <div class="chip-body">
              <div class="chip-name"><%=bLbl%></div>
              <div class="chip-sub"><%=bSub%></div>
            </div>
            <div class="chip-handle">⠿</div>
          </div>
          <%})%>
        </div>
      </div>

      <!-- Pool columns -->
      <div id="ldPoolCols" class="bld-pool-cols">
        <% (pools||[]).forEach((pool,pi)=>{ %>
        <div class="bld-pool-col" data-pool-idx="<%=pi%>" data-color="<%=pool.color||'#1d4ed8'%>">
          <div class="bld-col-header">
            <span class="bld-col-dot" style="background:<%=pool.color||'#1d4ed8'%>;"></span>
            <input class="ld-pool-name bld-col-name-input" value="<%=pool.name%>"/>
            <span class="bld-col-badge"><%=pool.poolMembers.length%></span>
            <button class="bld-col-remove" onclick="ldRemovePool(this)" title="Remove pool">×</button>
          </div>
          <div class="bld-drop-zone" style="background:<%=pool.color||'#1d4ed8'%>12;border:2px dashed <%=pool.color||'#1d4ed8'%>50;min-height:200px;padding:10px;">
            <%if(pool.poolMembers.length===0){%><div class="bld-empty-hint">Drop players here</div><%}%>
            <% pool.poolMembers.forEach(pm=>{
                 const pt=isDoublesCat?tByP1[pm.id]:null;
                 const pLbl=isDoublesCat&&pt?pt.name:(pm.full_name||pm.username);
                 const pSub=isDoublesCat&&pt?`${pt.p1full||pt.p1name} / ${pt.p2full||pt.p2name}`:`@${pm.username}`;
                 const pIni=bldIni(pLbl);
                 const pCp=isDoublesCat?(pt&&pt.color?[pt.color,pt.color+'bb']:BLD_PAL[0]):(bldColMap[pm.id]||BLD_PAL[0]);
            %>
            <div class="ld-chip" draggable="true"
                 data-pid="<%=pm.id%>" data-label="<%=pLbl%>" data-sub="<%=pSub%>"
                 data-ini="<%=pIni%>" data-cf="<%=pCp[0]%>" data-ct="<%=pCp[1]%>">
              <div class="chip-avatar" style="background:linear-gradient(135deg,<%=pCp[0]%>,<%=pCp[1]%>);"><%=pIni%></div>
              <div class="chip-body">
                <div class="chip-name"><%=pLbl%></div>
                <div class="chip-sub"><%=pSub%></div>
              </div>
              <div class="chip-handle">⠿</div>
            </div>
            <%})%>
          </div>
        </div>
        <%})%>

        <%if((pools||[]).length===0){%>
        <div class="bld-no-pools-hint">
          <div style="font-size:36px;margin-bottom:10px;">🏊</div>
          <div style="font-size:14px;font-weight:700;color:var(--gray-500);">No pools yet</div>
          <div style="font-size:12px;color:var(--gray-400);margin-top:5px;">Click <strong>+ Pool</strong> to create your first pool,<br>then drag players in from the Roster</div>
        </div>
        <%}%>
      </div>
    </div>
    <div style="padding:10px 20px 14px;font-size:11px;color:var(--gray-400);">Drag players between Roster and pool columns · Saving replaces all existing pool data</div>
  </div>
</div>
<%}%>

<!-- ══════════════════════════════════════════════════════════════════════════
     TAB 4 — POOL STANDINGS
     ══════════════════════════════════════════════════════════════════════════ -->
<% if(showPools){%>
<div id="tab-pools" class="ld-panel" style="display:none;">
  <% if(poolData.length===0){%>
  <div class="card"><div class="empty-state" style="padding:40px;"><div class="empty-icon">🏊</div><div class="empty-text">No pools configured</div></div></div>
  <%}%>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:14px;">
  <% poolData.forEach(pool=>{%>
  <div class="card">
    <div class="card-header">
      <div style="display:flex;align-items:center;gap:8px;">
        <div style="width:10px;height:10px;border-radius:2px;background:<%=pool.color||'#1d4ed8'%>;"></div>
        <div class="card-title"><%=pool.name%></div>
      </div>
      <span style="font-size:12px;color:var(--gray-400);"><%=pool.poolMembers.length%> players</span>
    </div>
    <table style="width:100%;border-collapse:collapse;font-size:12px;margin-bottom:10px;">
      <thead><tr style="color:var(--gray-400);border-bottom:1px solid var(--gray-100);">
        <th style="text-align:left;padding:4px 2px;font-weight:500;">#</th>
        <th style="text-align:left;padding:4px 2px;font-weight:500;"><%=isDoublesCat?'Team':'Player'%></th>
        <th style="text-align:center;padding:4px 2px;">P</th><th style="text-align:center;padding:4px 2px;">W</th><th style="text-align:center;padding:4px 2px;">L</th><th style="text-align:center;padding:4px 2px;font-weight:600;">Pts</th>
      </tr></thead>
      <tbody>
      <% pool.pStandings.forEach((s,i)=>{
           const isMe=s.id===uid;
           const t=isDoublesCat?tByP1[s.id]:null;
           const label=isDoublesCat&&t?t.name:(s.full_name||s.username);
      %>
      <tr style="border-bottom:1px solid var(--gray-50);<%=isMe?'background:var(--green-50);':''%>">
        <td style="padding:6px 2px;color:var(--gray-400);font-weight:600;"><%=i+1%></td>
        <td style="padding:6px 2px;font-weight:<%=isMe?700:500%>;color:<%=isMe?'var(--green-700)':'var(--gray-700)'%>;">
          <%=label%><%if(isDoublesCat&&t){%><div style="font-size:10px;color:var(--gray-400);"><%=t.p1full||t.p1name%>/<%=t.p2full||t.p2name%></div><%}%>
        </td>
        <td style="text-align:center;padding:6px 2px;color:var(--gray-500);"><%=s.played%></td>
        <td style="text-align:center;padding:6px 2px;color:var(--green-600);font-weight:600;"><%=s.wins%></td>
        <td style="text-align:center;padding:6px 2px;color:#dc2626;"><%=s.losses%></td>
        <td style="text-align:center;padding:6px 2px;font-weight:700;"><%=s.points%></td>
      </tr>
      <%})%>
      </tbody>
    </table>
    <!-- Pool fixtures with quick schedule/score -->
    <% if(isCreator){%>
    <div style="border-top:1px solid var(--gray-100);padding-top:10px;">
      <div style="font-size:11px;font-weight:600;color:var(--gray-400);text-transform:uppercase;margin-bottom:8px;">Fixtures</div>
      <% pool.fixtures.forEach(fx=>{
           const label1=fx.t1?fx.t1.name:(fx.p1.full_name||fx.p1.username);
           const label2=fx.t2?fx.t2.name:(fx.p2.full_name||fx.p2.username);
           const sub1=fx.t1?((fx.t1.p1full||fx.t1.p1name||'?')+' / '+(fx.t1.p2full||fx.t1.p2name||'?')):'';
           const sub2=fx.t2?((fx.t2.p1full||fx.t2.p1name||'?')+' / '+(fx.t2.p2full||fx.t2.p2name||'?')):'';
      %>
      <div style="display:flex;align-items:center;gap:6px;padding:5px 0;border-bottom:1px solid var(--gray-50);font-size:12px;">
        <div style="flex:1;min-width:0;color:var(--gray-700);"><%=label1%> <span style="color:var(--gray-300);">vs</span> <%=label2%></div>
        <% if(fx.match){%>
        <span style="font-size:11px;font-weight:600;color:var(--green-600);">✅ <%=fx.match.score%></span>
        <%}else if(fx.accepted){%>
        <span style="font-size:11px;color:#1d4ed8;">📅 <%=fmtDT(fx.accepted.scheduled_at)%></span>
        <%}else{%>
        <button onclick="ldCalLink('<%=fx.p2.id%>','<%=label1%>','<%=label2%>')" style="font-size:11px;padding:2px 6px;background:none;border:1px solid var(--gray-200);border-radius:4px;cursor:pointer;" title="Schedule via Calendar">📅</button>
        <button onclick="ldOpenScore('<%=league.id%>','<%=fx.t1?fx.t1.id:0%>','<%=fx.t2?fx.t2.id:0%>','<%=fx.p1.id%>','<%=fx.p2.id%>','<%=label1%>','<%=label2%>','<%=sub1%>','<%=sub2%>')" style="font-size:11px;padding:2px 6px;background:none;border:1px solid var(--gray-200);border-radius:4px;cursor:pointer;" title="Enter score">✏️</button>
        <%}%>
      </div>
      <%})%>
    </div>
    <%}%>
  </div>
  <%})%>
  </div>

</div>
<%}%>

<!-- ══════════════════════════════════════════════════════════════════════════
     TAB 5 — MATCHES (history + fixtures)
     ══════════════════════════════════════════════════════════════════════════ -->
<% if(showFixtures){%>
<div id="tab-matches" class="ld-panel" style="display:none;">

  <!-- Pool fixtures (only when pools exist) -->
  <% if(hasPools){%>
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
    <div style="font-size:13px;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:.06em;">Pool Fixtures</div>
    <% if(showCalendar){%><button onclick="ldTab('calendar')" class="btn btn-outline btn-sm" style="font-size:12px;gap:5px;">📅 View Calendar</button><%}%>
  </div>
  <% poolData.forEach(function(pool){%>
  <div class="card" style="margin-bottom:14px;">
    <div class="card-header">
      <div style="display:flex;align-items:center;gap:8px;">
        <div style="width:10px;height:10px;border-radius:2px;background:<%=pool.color||'#1d4ed8'%>;"></div>
        <div class="card-title"><%=pool.name%></div>
      </div>
      <span style="font-size:12px;color:var(--gray-400);"><%=pool.fixtures.length%> fixtures</span>
    </div>
    <% if(pool.poolMembers.length < 2){%>
    <div class="empty-state" style="padding:24px;">
      <div class="empty-icon" style="font-size:24px;">🏊</div>
      <div class="empty-text" style="font-size:13px;">Not enough players assigned to this pool</div>
      <div style="font-size:12px;color:var(--gray-400);margin-top:4px;">This pool has <%=pool.poolMembers.length%> player(s) — need at least 2 to generate fixtures. <% if(isCreator){%><button onclick="ldTab('builder')" class="btn btn-outline btn-sm" style="font-size:11px;margin-left:6px;vertical-align:middle;">Go to Builder →</button><%}%></div>
    </div>
    <%}else{%>
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
      <thead><tr style="color:var(--gray-400);border-bottom:1px solid var(--gray-100);">
        <th style="text-align:left;padding:7px 6px;font-weight:500;">#</th>
        <th style="text-align:left;padding:7px 6px;font-weight:500;">Match</th>
        <th style="text-align:left;padding:7px 6px;font-weight:500;">Date / Status</th>
        <th style="text-align:left;padding:7px 6px;font-weight:500;">Score</th>
        <% if(isCreator){%>
        <th style="text-align:center;padding:7px 6px;font-weight:500;">📅 Schedule</th>
        <th style="text-align:center;padding:7px 6px;font-weight:500;">✏️ Score</th>
        <%}%>
      </tr></thead>
      <tbody>
      <% pool.fixtures.forEach(function(fx,fxi){
           var label1=fx.t1?fx.t1.name:(fx.p1.full_name||fx.p1.username);
           var label2=fx.t2?fx.t2.name:(fx.p2.full_name||fx.p2.username);
           var sub1=fx.t1?`${fx.t1.p1full||fx.t1.p1name}/${fx.t1.p2full||fx.t1.p2name}`:'';
           var sub2=fx.t2?`${fx.t2.p1full||fx.t2.p1name}/${fx.t2.p2full||fx.t2.p2name}`:'';
      %>
      <tr style="border-bottom:1px solid var(--gray-50);">
        <td style="padding:8px 6px;color:var(--gray-400);"><%=fxi+1%></td>
        <td style="padding:8px 6px;">
          <div style="font-weight:500;color:var(--gray-800);"><%=label1%> <span style="color:var(--gray-300);">vs</span> <%=label2%></div>
          <% if(sub1||sub2){%><div style="font-size:11px;color:var(--gray-400);"><%=sub1%> · <%=sub2%></div><%}%>
        </td>
        <td style="padding:8px 6px;">
          <% if(fx.match){%>
          <span style="font-size:12px;font-weight:600;color:var(--green-700);">✅ Played <%=fmtDate(fx.match.played_at)%></span>
          <%}else if(fx.accepted){%>
          <span style="font-size:12px;color:#1d4ed8;font-weight:600;">📅 <%=fmtDT(fx.accepted.scheduled_at)%></span>
          <%}else{%>
          <span style="font-size:12px;color:var(--gray-400);">— Not scheduled</span>
          <%}%>
        </td>
        <td style="padding:8px 6px;font-weight:600;color:var(--gray-800);"><%=fx.match?fx.match.score:'—'%></td>
        <% if(isCreator){%>
        <td style="text-align:center;padding:8px 6px;">
          <% if(!fx.match){%>
          <button onclick="ldCalLink('<%=fx.p2.id%>','<%=label1%>','<%=label2%>')"
            style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:14px;color:#1d4ed8;" title="Schedule via Calendar">📅</button>
          <%}else{%><span style="color:var(--gray-300);font-size:12px;">—</span><%}%>
        </td>
        <td style="text-align:center;padding:8px 6px;">
          <% if(!fx.match){%>
          <button onclick="ldOpenScore('<%=league.id%>','<%=fx.t1?fx.t1.id:0%>','<%=fx.t2?fx.t2.id:0%>','<%=fx.p1.id%>','<%=fx.p2.id%>','<%=label1%>','<%=label2%>','<%=sub1%>','<%=sub2%>')"
            style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:14px;color:#16a34a;" title="Enter score">✏️</button>
          <%}else{%><span style="color:var(--gray-300);font-size:12px;">—</span><%}%>
        </td>
        <%}%>
      </tr>
      <%});%>
      </tbody>
    </table>
    <%}%>
  </div>
  <%});%>
  <%}%>

  <!-- Played match history -->
  <% if(hasPools){%><div style="font-size:13px;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:.06em;margin-top:20px;margin-bottom:10px;">Match History</div><%}%>
  <div class="card" style="padding:0;overflow:hidden;margin-bottom:16px;">
    <div class="card-header" style="padding:14px 16px 12px;">
      <div class="card-title">🎾 Match History</div>
      <span style="font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--gray-100);color:var(--gray-500);"><%=lmatches.length%> matches</span>
    </div>
    <% if(lmatches.length===0){%>
    <div class="empty-state" style="padding:40px;"><div class="empty-icon">🎾</div><div class="empty-text">No matches recorded yet</div></div>
    <%}else{%>
    <div>
      <% lmatches.forEach(function(m){
           var isD=m.match_type==='doubles';
           var onT1=m.player1_id===uid||m.player1_partner_id===uid;
           var onT2=m.player2_id===uid||m.player2_partner_id===uid;
           var involved=onT1||onT2;
           var t1won=m.winner_id&&(m.winner_id===m.player1_id||m.winner_id===m.player1_partner_id);
           var t2won=m.winner_id&&(m.winner_id===m.player2_id||m.winner_id===m.player2_partner_id);
           var myWin=involved&&((onT1&&t1won)||(onT2&&t2won));
           var oc=myWin?'win':(involved&&m.winner_id?'loss':'nr');
           var t1l=isD&&m.p1partnername?`${m.p1name}/${m.p1partnername}`:m.p1name;
           var t2l=isD&&m.p2partnername?`${m.p2name}/${m.p2partnername}`:m.p2name;
           var accentColor3=oc==='win'?'var(--green-500)':oc==='loss'?'#ef4444':'var(--gray-200)';
      %>
      <div style="display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid var(--gray-50);border-left:3px solid <%=accentColor3%>;">
        <% if(involved){%>
        <div style="width:30px;height:30px;border-radius:8px;background:<%=oc==='win'?'var(--green-100)':oc==='loss'?'#fee2e2':'var(--gray-100)'%>;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:<%=oc==='win'?'var(--green-700)':oc==='loss'?'#dc2626':'var(--gray-400)'%>;flex-shrink:0;"><%=oc==='win'?'W':oc==='loss'?'L':'–'%></div>
        <%}else{%><div style="width:30px;text-align:center;font-size:16px;flex-shrink:0;">🎾</div><%}%>
        <div style="flex:1;min-width:0;">
          <div style="font-size:13px;font-weight:600;color:var(--gray-800);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><strong><%=t1l%></strong> <span style="color:var(--gray-400);font-weight:400;">vs</span> <strong><%=t2l%></strong></div>
          <div style="font-size:11px;color:var(--gray-400);margin-top:1px;"><%=fmtDate(m.played_at)%><% if(m.winnername){%> · 🏆 <%=m.winnername%><%}%><% if(m.venue){%> · 📍 <%=m.venue%><%}%></div>
        </div>
        <div style="text-align:right;flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:3px;">
          <div style="font-size:13px;font-weight:700;color:var(--gray-700);"><%=m.score%></div>
          <div style="display:flex;gap:3px;">
            <span class="match-surface surface-<%=m.surface%>" style="font-size:10px;"><%=m.surface%></span>
            <span style="font-size:10px;padding:1px 5px;border-radius:999px;background:<%=isD?'#ede9fe':'#dcfce7'%>;color:<%=isD?'#7c3aed':'#166534'%>;"><%=isD?'Dbl':'Sgl'%></span>
          </div>
        </div>
      </div>
      <%});%>
    </div>
    <%}%>
  </div>

</div>
<%}%>

<!-- ══ Calendar Proposal Modal ════════════════════════════════════════════════ -->
<% if(isMember&&isActive){%>
<div id="ldCalModal" class="ld-modal-overlay" onclick="if(event.target===this)ldCloseModal('ldCalModal')" style="display:none;">
  <div class="ld-modal ld-cal-modal-dialog" onclick="event.stopPropagation()">

    <!-- Header -->
    <div class="ld-modal-header" style="background:linear-gradient(135deg,var(--green-900),var(--green-700));color:#fff;">
      <div>
        <div class="ld-modal-title" style="color:#fff;">📅 Schedule Match</div>
        <div id="ldCalModalSub" class="ld-modal-sub" style="color:rgba(255,255,255,.75);"></div>
      </div>
      <button class="ld-modal-close" onclick="ldCloseModal('ldCalModal')" style="background:rgba(255,255,255,.15);color:#fff;">✕</button>
    </div>

    <!-- Body: calendar left + form right -->
    <div class="ld-cal-modal-body">

      <!-- Left: live calendar -->
      <div class="ld-cal-modal-left">
        <div style="display:flex;align-items:center;gap:6px;margin-bottom:10px;flex-wrap:wrap;">
          <button onclick="ldModalCalNav(-1)" class="btn btn-outline btn-sm" style="padding:3px 10px;">‹</button>
          <div id="calModalMonthTitle" style="flex:1;text-align:center;font-size:13px;font-weight:700;color:var(--gray-700);"></div>
          <button onclick="ldModalCalNav(1)"  class="btn btn-outline btn-sm" style="padding:3px 10px;">›</button>
          <button onclick="ldModalCalNav(0)"  class="btn btn-outline btn-sm" style="font-size:11px;">Today</button>
        </div>
        <div id="calModalGrid" style="display:grid;grid-template-columns:repeat(7,1fr);gap:2px;"></div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;font-size:10px;color:var(--gray-400);margin-top:8px;padding-top:6px;border-top:1px solid var(--gray-100);">
          <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:#536D33;margin-right:3px;"></span>Played</span>
          <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:#1d4ed8;margin-right:3px;"></span>Confirmed</span>
          <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:#7c3aed;margin-right:3px;"></span>Incoming</span>
          <span><span style="display:inline-block;width:7px;height:7px;border-radius:2px;background:#d97706;margin-right:3px;"></span>Outgoing</span>
        </div>
        <div style="font-size:11px;color:var(--green-700);font-weight:600;margin-top:8px;padding:6px 8px;background:var(--green-50);border-radius:6px;border:1px solid var(--green-200);">
          💡 Click any date to add it as a proposed time slot
        </div>
      </div>

      <!-- Right: Proposal form -->
      <div class="ld-cal-modal-right">
        <form method="POST" id="calModalProposalForm">
          <div class="form-group">
            <label class="form-label">Opponent</label>
            <select class="form-input" name="opponent_id" id="calModalOpponentSel" required></select>
          </div>
          <div class="form-group">
            <label class="form-label" style="display:flex;align-items:center;justify-content:space-between;">
              <span>Proposed Time Slots <span style="font-size:10px;color:var(--gray-400);font-weight:400;">(up to 4 — click calendar days)</span></span>
              <button type="button" onclick="ldModalClearSlots()" style="background:none;border:none;cursor:pointer;font-size:11px;color:var(--gray-400);padding:0;">Clear all</button>
            </label>
            <input class="form-input" name="slots" type="datetime-local" id="calModalSlot0" style="margin-bottom:5px;"/>
            <input class="form-input" name="slots" type="datetime-local" id="calModalSlot1" style="margin-bottom:5px;"/>
            <input class="form-input" name="slots" type="datetime-local" id="calModalSlot2" style="margin-bottom:5px;"/>
            <input class="form-input" name="slots" type="datetime-local" id="calModalSlot3"/>
          </div>
          <div class="form-group">
            <label class="form-label">Venue <span style="font-weight:400;color:var(--gray-400);">(optional)</span></label>
            <input class="form-input" name="venue" type="text" placeholder="e.g. Court 3, City Tennis Club"/>
          </div>
          <div style="display:flex;gap:8px;margin-top:4px;">
            <button type="button" class="btn btn-outline btn-sm" onclick="ldCloseModal('ldCalModal')" style="flex:1;">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm" style="flex:2;">📤 Send Proposal</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<%}%>

<!-- ══ Score Modal ════════════════════════════════════════════════════════════ -->
<% if(isCreator&&isActive){%>
<div id="ldScoreModal" class="ld-modal-overlay" onclick="if(event.target===this)ldCloseModal('ldScoreModal')" style="display:none;">
  <div class="ld-modal" onclick="event.stopPropagation()">
    <div class="ld-modal-header">
      <div>
        <div class="ld-modal-title">✏️ Enter Score</div>
        <div id="ldScoreMatchLabel" class="ld-modal-sub"></div>
        <div id="ldScorePlayerSub" style="font-size:11px;color:rgba(255,255,255,.6);margin-top:2px;display:none;"></div>
      </div>
      <button class="ld-modal-close" onclick="ldCloseModal('ldScoreModal')">✕</button>
    </div>
    <form method="POST" id="ldScoreForm" class="ld-modal-body">
      <input type="hidden" name="team1_id" id="ldScore_t1"/>
      <input type="hidden" name="team2_id" id="ldScore_t2"/>

      <!-- Score input -->
      <div class="form-group" style="margin-bottom:14px;">
        <label class="form-label" style="display:flex;align-items:baseline;gap:6px;">
          Score
          <span style="font-size:10px;color:var(--gray-400);font-weight:400;">sets separated by comma · e.g. 6-3, 7-5</span>
        </label>
        <div style="display:flex;gap:6px;align-items:center;">
          <input id="ldScoreInput" class="form-input" name="score" type="text"
            placeholder="6-3, 7-5  or  6-3, 4-6, 7-5" autocomplete="off" style="flex:1;transition:border-color .15s,box-shadow .15s;"
            oninput="ldScoreValidate()"/>
          <button type="button" onclick="ldScoreClear()" title="Clear"
            style="flex-shrink:0;width:34px;height:38px;border:1px solid var(--gray-200);border-radius:6px;background:#fff;cursor:pointer;color:var(--gray-400);font-size:13px;display:flex;align-items:center;justify-content:center;">✕</button>
        </div>
        <!-- Quick-add set chips -->
        <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;align-items:center;">
          <span style="font-size:10px;color:var(--gray-400);white-space:nowrap;margin-right:2px;">+ Add set:</span>
          <% ['6-0','6-1','6-2','6-3','6-4','7-5','7-6','0-6','1-6','2-6','3-6','4-6','5-7','6-7'].forEach(function(sq){ %>
          <button type="button" onclick="ldScoreAddSet('<%=sq%>')"
            style="font-size:11px;padding:2px 8px;border:1px solid var(--gray-200);border-radius:999px;background:#fff;cursor:pointer;color:var(--gray-600);transition:all .12s;"
            onmouseover="this.style.background='var(--green-50)';this.style.borderColor='var(--green-300)';this.style.color='var(--green-700)';"
            onmouseout="this.style.background='#fff';this.style.borderColor='var(--gray-200)';this.style.color='var(--gray-600)';"><%=sq%></button>
          <% }) %>
        </div>
        <!-- Live set preview -->
        <div id="ldScorePreview" style="display:none;margin-top:8px;padding:8px 10px;background:var(--gray-50);border-radius:7px;border:1px solid var(--gray-100);"></div>
        <!-- Validation error -->
        <div id="ldScoreError" style="display:none;margin-top:5px;font-size:11px;color:#dc2626;"></div>
      </div>

      <!-- Winner + Surface -->
      <div class="ld-modal-grid">
        <div class="form-group">
          <label class="form-label">Winner</label>
          <select class="form-input" name="winner_team_id" id="ldScore_winnerSel">
            <option value="">No result / walkover</option>
          </select>
          <div id="ldScoreWinnerHint" style="display:none;margin-top:3px;font-size:11px;color:var(--green-600);"></div>
        </div>
        <div class="form-group">
          <label class="form-label">Surface</label>
          <select class="form-input" name="surface">
            <option value="hard">Hard</option>
            <option value="clay">Clay</option>
            <option value="grass">Grass</option>
          </select>
        </div>
      </div>

      <!-- Date -->
      <div class="form-group" style="margin-bottom:0;">
        <label class="form-label">Date played</label>
        <input class="form-input" name="played_at" type="datetime-local"/>
      </div>

      <div class="ld-modal-footer">
        <button type="button" class="btn btn-outline btn-sm" onclick="ldCloseModal('ldScoreModal')">Cancel</button>
        <button type="submit" class="btn btn-primary btn-sm">✓ Save Score</button>
      </div>
    </form>
  </div>
</div>
<%}%>

<!-- ══════════════════════════════════════════════════════════════════════════
     TAB 6 — CALENDAR
     ══════════════════════════════════════════════════════════════════════════ -->
<% if(showCalendar){%>
<div id="tab-calendar" class="ld-panel" style="display:none;">
  <div style="display:grid;grid-template-columns:1fr 320px;gap:16px;" class="cal-grid">

    <!-- Calendar grid -->
    <div class="card">
      <div class="card-header">
        <div style="display:flex;align-items:center;gap:8px;">
          <button id="calPrevBtn" onclick="ldCalNav(-1)" class="btn btn-outline btn-sm" style="padding:3px 10px;">‹</button>
          <div class="card-title" id="calMonthTitle" style="min-width:140px;text-align:center;"></div>
          <button id="calNextBtn" onclick="ldCalNav(1)" class="btn btn-outline btn-sm" style="padding:3px 10px;">›</button>
        </div>
        <button onclick="ldCalNav(0)" class="btn btn-outline btn-sm" style="font-size:11px;">Today</button>
      </div>
      <div id="calGrid" style="display:grid;grid-template-columns:repeat(7,1fr);gap:2px;"></div>
      <div style="display:flex;gap:12px;flex-wrap:wrap;font-size:11px;color:var(--gray-500);margin-top:10px;padding-top:8px;border-top:1px solid var(--gray-100);">
        <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#536D33;margin-right:4px;"></span>Played</span>
        <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#1d4ed8;margin-right:4px;"></span>Confirmed</span>
        <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#7c3aed;margin-right:4px;"></span>Incoming</span>
        <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#d97706;margin-right:4px;"></span>Outgoing</span>
      </div>
    </div>

    <!-- Sidebar: proposals + new proposal form -->
    <div style="display:flex;flex-direction:column;gap:14px;">

      <!-- Incoming proposals -->
      <% if((_cp.incoming||[]).length>0){%>
      <div class="card">
        <div class="card-header"><div class="card-title" style="font-size:13px;">📬 Incoming Proposals</div></div>
        <% (_cp.incoming||[]).forEach(prop=>{%>
        <div style="padding:8px 0;border-bottom:1px solid var(--gray-50);">
          <div style="font-size:12px;font-weight:600;color:var(--gray-800);"><%=prop.proposer_full||prop.proposer_name%></div>
          <% (prop.slots||[]).forEach(sl=>{%>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-top:4px;">
            <span style="font-size:11px;color:var(--gray-600);"><%=fmtDT(sl.proposed_at)%></span>
            <form method="POST" action="/leagues/<%=league.id%>/proposals/<%=prop.id%>/accept" style="margin:0;">
              <input type="hidden" name="slot_id" value="<%=sl.id%>"/>
              <button type="submit" class="btn btn-primary btn-sm" style="font-size:10px;padding:2px 8px;">Accept</button>
            </form>
          </div>
          <%})%>
          <form method="POST" action="/leagues/<%=league.id%>/proposals/<%=prop.id%>/decline" style="margin-top:6px;">
            <button type="submit" class="btn btn-outline btn-sm" style="font-size:10px;padding:2px 8px;color:#dc2626;border-color:#fecaca;">Decline</button>
          </form>
        </div>
        <%})%>
      </div>
      <%}%>

      <!-- Confirmed upcoming -->
      <% const upcomingConf=(_cp.accepted||[]).filter(ap=>{try{return new Date(ap.accepted_at||ap.scheduled_at)>new Date();}catch(e){return false;}});%>
      <% if(upcomingConf.length>0){%>
      <div class="card">
        <div class="card-header"><div class="card-title" style="font-size:13px;">✅ Confirmed Matches</div></div>
        <% upcomingConf.forEach(ap=>{
             const isProposer=ap.proposer_id===uid;
             const partnerName=isProposer?(ap.opponent_full||ap.opponent_name):(ap.proposer_full||ap.proposer_name);
        %>
        <div style="padding:6px 0;border-bottom:1px solid var(--gray-50);">
          <div style="font-size:12px;font-weight:600;color:var(--gray-800);">vs <%=partnerName%></div>
          <div style="font-size:11px;color:#1d4ed8;">📅 <%=fmtDT(ap.accepted_at||ap.scheduled_at)%></div>
          <% if(isProposer){%>
          <form method="POST" action="/leagues/<%=league.id%>/proposals/<%=ap.id%>/cancel" style="margin-top:4px;">
            <button type="submit" class="btn btn-outline btn-sm" style="font-size:10px;padding:2px 8px;color:#dc2626;" onclick="return confirm('Cancel this confirmed match?')">Cancel</button>
          </form>
          <%}%>
        </div>
        <%})%>
      </div>
      <%}%>

      <!-- Sent proposals -->
      <% if((_cp.outgoing||[]).length>0){%>
      <div class="card">
        <div class="card-header"><div class="card-title" style="font-size:13px;">📤 Sent Proposals</div></div>
        <% (_cp.outgoing||[]).forEach(prop=>{%>
        <div style="padding:6px 0;border-bottom:1px solid var(--gray-50);">
          <div style="font-size:12px;font-weight:600;color:var(--gray-800);">→ <%=prop.opponent_full||prop.opponent_name%></div>
          <div style="font-size:11px;color:var(--gray-500);"><%=(prop.slots||[]).length%> slot(s) offered</div>
          <form method="POST" action="/leagues/<%=league.id%>/proposals/<%=prop.id%>/cancel" style="margin-top:4px;">
            <button type="submit" class="btn btn-outline btn-sm" style="font-size:10px;padding:2px 8px;color:#dc2626;" onclick="return confirm('Withdraw this proposal?')">Withdraw</button>
          </form>
        </div>
        <%})%>
      </div>
      <%}%>

      <!-- New Proposal form -->
      <div class="card" id="calProposalCard">
        <div class="card-header">
          <div class="card-title" style="font-size:13px;">📬 New Proposal</div>
        </div>
        <div id="calProposalHint" style="display:none;background:var(--green-50);border-radius:8px;padding:8px 10px;font-size:12px;color:var(--green-700);font-weight:600;margin-bottom:8px;border:1px solid var(--green-200);"></div>
        <form method="POST" action="/leagues/<%=league.id%>/proposals/new">
          <div class="form-group">
            <label class="form-label" style="font-size:12px;">Opponent</label>
            <select class="form-input" name="opponent_id" id="calOpponentSel" required style="font-size:12px;">
              <option value="">— select opponent —</option>
              <% members.filter(m=>m.id!==uid).forEach(m=>{%><option value="<%=m.id%>"><%=m.full_name||m.username%></option><%})%>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" style="font-size:12px;">Proposed times (up to 4)</label>
            <input class="form-input" name="slots" type="datetime-local" style="font-size:12px;margin-bottom:4px;"/>
            <input class="form-input" name="slots" type="datetime-local" style="font-size:12px;margin-bottom:4px;"/>
            <input class="form-input" name="slots" type="datetime-local" style="font-size:12px;margin-bottom:4px;"/>
            <input class="form-input" name="slots" type="datetime-local" style="font-size:12px;"/>
          </div>
          <div class="form-group">
            <label class="form-label" style="font-size:12px;">Venue (optional)</label>
            <input class="form-input" name="venue" type="text" placeholder="Court / location" style="font-size:12px;"/>
          </div>
          <button type="submit" class="btn btn-primary btn-sm btn-full">📤 Send Proposal</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%}%>

<!-- ══════════════════════════════════════════════════════════════════════════
     TAB 7 — PLAYERS
     ══════════════════════════════════════════════════════════════════════════ -->
<div id="tab-players" class="ld-panel" style="display:none;">
  <div class="card">
