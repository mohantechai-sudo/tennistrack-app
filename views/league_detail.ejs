            <div style="flex:1;min-width:0;">
              <div style="font-size:13px;font-weight:700;color:var(--gray-800);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%=s.full_name||s.username%><% if(isMe){%> <span style="font-size:10px;font-weight:600;padding:1px 5px;border-radius:999px;background:var(--green-100);color:var(--green-700);margin-left:3px;">you</span><%}%></div>
              <div style="font-size:11px;color:var(--gray-400);margin-top:1px;">@<%=s.username%></div>
            </div>
            <div style="text-align:right;flex-shrink:0;">
              <% if(rankMedal){%><div style="font-size:18px;line-height:1;"><%=rankMedal%></div><%}else{%><div style="font-size:13px;font-weight:700;color:var(--gray-500);">#<%=i+1%></div><%}%>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;text-align:center;padding:8px 0;border-top:1px solid var(--gray-100);">
            <div><div style="font-size:16px;font-weight:800;color:var(--green-700);"><%=s.wins%></div><div style="font-size:10px;color:var(--gray-400);">Wins</div></div>
            <div><div style="font-size:16px;font-weight:800;color:#ef4444;"><%=s.losses%></div><div style="font-size:10px;color:var(--gray-400);">Losses</div></div>
            <div><div style="font-size:16px;font-weight:800;color:var(--gray-700);"><%=s.points%></div><div style="font-size:10px;color:var(--gray-400);">Pts</div></div>
          </div>
          <% if(totalGames>0){%>
          <div style="margin-top:8px;">
            <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--gray-400);margin-bottom:3px;"><span>Win rate</span><span style="font-weight:700;color:var(--gray-600);"><%=winRate%>%</span></div>
            <div style="background:var(--gray-100);border-radius:999px;height:4px;overflow:hidden;"><div style="width:<%=winRate%>%;height:100%;background:<%=winRate>=60?'var(--green-500)':winRate>=40?'#d97706':'#ef4444'%>;border-radius:999px;transition:.3s;"></div></div>
          </div>
          <%}%>
        </div>
      </a>
      <%})%>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     JAVASCRIPT
     ══════════════════════════════════════════════════════════════════════════ -->
<script>
// ── Tab switching ────────────────────────────────────────────────────────────
const LD_TABS = ['overview','dashboard','builder','pools','matches','calendar','players'];
function ldTab(name) {
  LD_TABS.forEach(t => {
    const panel = document.getElementById('tab-'+t);
    const btn = document.querySelector('[data-tab="'+t+'"]');
    if (panel) panel.style.display = t===name ? '' : 'none';
    if (btn)  btn.classList.toggle('ld-tab-active', t===name);
  });
  location.hash = name;
  if (name === 'calendar') ldCalRender();
}
// Restore from hash or default
(function(){
  const h = location.hash.replace('#','');
  ldTab(LD_TABS.includes(h) ? h : 'overview');
})();

// ── Pool Builder v2 ──────────────────────────────────────────────────────────
let ldDragPid = null;
(function initBldDnD() {
  document.addEventListener('dragstart', e => {
    const chip = e.target.closest('.ld-chip');
    if (!chip) return;
    ldDragPid = chip.dataset.pid;
    e.dataTransfer.effectAllowed = 'move';
    setTimeout(() => chip.classList.add('chip-dragging'), 0);
  });
  document.addEventListener('dragend', () => {
    document.querySelectorAll('.chip-dragging').forEach(c => c.classList.remove('chip-dragging'));
    document.querySelectorAll('.bld-drop-zone.drag-over').forEach(z => z.classList.remove('drag-over'));
  });
  document.addEventListener('dragover', e => {
    const zone = e.target.closest('.bld-drop-zone');
    if (!zone) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    document.querySelectorAll('.bld-drop-zone.drag-over').forEach(z => { if (z !== zone) z.classList.remove('drag-over'); });
    zone.classList.add('drag-over');
  });
  document.addEventListener('dragleave', e => {
    const zone = e.target.closest('.bld-drop-zone');
    if (zone && !zone.contains(e.relatedTarget)) zone.classList.remove('drag-over');
  });
  document.addEventListener('drop', e => {
    const zone = e.target.closest('.bld-drop-zone');
    if (!zone || !ldDragPid) return;
    e.preventDefault();
    zone.classList.remove('drag-over');
    ldDropToZone(zone);
  });
})();

function ldDropToZone(zone) {
  const pid = ldDragPid; ldDragPid = null;
  if (!pid) return;
  if (zone.querySelector(`.ld-chip[data-pid="${pid}"]`)) return;
  const src = document.querySelector(`.ld-chip[data-pid="${pid}"]`);
  if (!src) return;
  const { label, sub, ini, cf, ct } = src.dataset;
  src.remove();
  zone.querySelector('.bld-empty-hint')?.remove();
  zone.appendChild(ldMakeChip(pid, label, sub, ini, cf, ct));
  document.querySelectorAll('.bld-drop-zone').forEach(z => {
    if (!z.querySelector('.ld-chip') && !z.querySelector('.bld-empty-hint')) {
      const h = document.createElement('div');
      h.className = 'bld-empty-hint';
      h.textContent = z.id === 'ldUnassigned' ? 'All assigned ✓' : 'Drop players here';
      z.appendChild(h);
    }
  });
  ldSyncCounters();
}

function ldMakeChip(pid, label, sub, ini, cf, ct) {
  const d = document.createElement('div');
  d.className = 'ld-chip'; d.draggable = true;
  Object.assign(d.dataset, { pid, label: label||'', sub: sub||'', ini: ini||(label||'?').substring(0,2).toUpperCase(), cf: cf||'#536D33', ct: ct||'#769B49' });
  d.innerHTML = `<div class="chip-avatar" style="background:linear-gradient(135deg,${d.dataset.cf},${d.dataset.ct});">${d.dataset.ini}</div><div class="chip-body"><div class="chip-name">${d.dataset.label}</div><div class="chip-sub">${d.dataset.sub}</div></div><div class="chip-handle">⠿</div>`;
  return d;
}

function ldSyncCounters() {
  const total = document.querySelectorAll('.bld-drop-zone .ld-chip').length;
  const unassigned = document.querySelectorAll('#ldUnassigned .ld-chip').length;
  const assigned = total - unassigned;
  const lbl = document.getElementById('bldCountLabel');
  const fill = document.getElementById('bldProgressFill');
  const rc = document.getElementById('bldRosterCount');
  if (lbl) lbl.textContent = `${assigned} of ${total} assigned`;
  if (fill && total > 0) fill.style.width = Math.round(assigned / total * 100) + '%';
  if (rc) rc.textContent = unassigned;
  document.querySelectorAll('.bld-pool-col').forEach(col => {
    const b = col.querySelector('.bld-col-badge');
    if (b) b.textContent = col.querySelectorAll('.ld-chip').length;
  });
}

function ldAddPool() {
  const container = document.getElementById('ldPoolCols');
  container.querySelector('.bld-no-pools-hint')?.remove();
  const idx = container.querySelectorAll('.bld-pool-col').length;
  const COLS = ['#1d4ed8','#7c3aed','#059669','#dc2626','#d97706','#0891b2','#be185d','#65a30d'];
  const col = COLS[idx % COLS.length];
  const name = `Pool ${String.fromCharCode(65 + idx)}`;
  const div = document.createElement('div');
  div.className = 'bld-pool-col'; div.dataset.poolIdx = idx; div.dataset.color = col;
  div.innerHTML = `<div class="bld-col-header"><span class="bld-col-dot" style="background:${col};"></span><input class="ld-pool-name bld-col-name-input" value="${name}"/><span class="bld-col-badge">0</span><button class="bld-col-remove" onclick="ldRemovePool(this)" title="Remove pool">×</button></div><div class="bld-drop-zone" style="background:${col}12;border:2px dashed ${col}50;min-height:200px;padding:10px;"><div class="bld-empty-hint">Drop players here</div></div>`;
  container.appendChild(div);
}

function ldRemovePool(btn) {
  const col = btn.closest('.bld-pool-col');
  const roster = document.getElementById('ldUnassigned');
  const chips = col.querySelectorAll('.ld-chip');
  if (chips.length > 0) {
    roster.querySelector('.bld-empty-hint')?.remove();
    chips.forEach(c => roster.appendChild(c.cloneNode(true)));
  }
  col.remove();
  if (!document.querySelector('.bld-pool-col')) {
    const h = document.createElement('div');
    h.className = 'bld-no-pools-hint';
    h.innerHTML = '<div style="font-size:36px;margin-bottom:10px;">🏊</div><div style="font-size:14px;font-weight:700;color:var(--gray-500);">No pools yet</div><div style="font-size:12px;color:var(--gray-400);margin-top:5px;">Click <strong>+ Pool</strong> to add your first pool</div>';
    document.getElementById('ldPoolCols').appendChild(h);
  }
  ldSyncCounters();
}

function ldSavePools() {
  const data = [];
  let warn = [];
  document.querySelectorAll('.bld-pool-col').forEach(col => {
    const name = col.querySelector('.ld-pool-name')?.value || 'Pool';
    const color = col.dataset.color || '#1d4ed8';
    const players = Array.from(col.querySelectorAll('.bld-drop-zone .ld-chip')).map(c => c.dataset.pid);
    if (players.length < 2) warn.push(`"${name}" has ${players.length} player(s) — needs at least 2 for fixtures`);
    data.push({ name, color, players });
  });
  if (warn.length && !confirm('Some pools are incomplete:\n\n' + warn.join('\n') + '\n\nSave anyway?')) return false;
  document.getElementById('poolsJsonInput').value = JSON.stringify(data);
  return true;
}

// ── Modal helpers ─────────────────────────────────────────────────────────────
function ldOpenModal(id) {
  document.getElementById(id).style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function ldCloseModal(id) {
  document.getElementById(id).style.display = 'none';
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    ['ldCalModal','ldScoreModal'].forEach(id => {
      const el = document.getElementById(id);
      if (el && el.style.display !== 'none') ldCloseModal(id);
    });
  }
});

// ── Opponent data for modal dropdown ─────────────────────────────────────────
const _calIsDoubles = <%- JSON.stringify(isDoublesCat) %>;
const _calTeams = <%- JSON.stringify((teams||[]).map(t=>({
  id: t.player1_id,
  name: t.name,
  sub: (t.p1full||t.p1name||'?') + ' / ' + (t.p2full||t.p2name||'?')
}))) %>;
const _calMembers = <%- JSON.stringify(members.filter(m=>m.id!==uid).map(m=>({
  id: m.id,
  name: m.full_name||m.username,
  sub: '@'+(m.username||'')
}))) %>;
const _calLeagueId = <%- JSON.stringify(league.id) %>;

// ── Calendar Proposal Modal ───────────────────────────────────────────────────
let _mCalYear = new Date().getFullYear(), _mCalMonth = new Date().getMonth();

function ldCalLink(opponentId, label1, label2) {
  // Set modal subtitle
  const sub = document.getElementById('ldCalModalSub');
  if (sub) sub.textContent = `${label1}  vs  ${label2}`;
  // Set form action
  const form = document.getElementById('calModalProposalForm');
  if (form) form.action = `/leagues/${_calLeagueId}/proposals/new`;
  // Build opponent dropdown
  const sel = document.getElementById('calModalOpponentSel');
  if (sel) {
    const list = _calIsDoubles ? _calTeams : _calMembers;
    sel.innerHTML = list.map(o =>
      `<option value="${o.id}">${o.name}${o.sub ? ' — ' + o.sub : ''}</option>`
    ).join('');
    sel.value = String(opponentId);
  }
  // Clear previous slot inputs
  ldModalClearSlots();
  // Render modal calendar at current month
  _mCalYear = new Date().getFullYear();
  _mCalMonth = new Date().getMonth();
  ldModalCalRender();
  ldOpenModal('ldCalModal');
}

function ldModalCalNav(dir) {
  if (dir === 0) { _mCalYear = new Date().getFullYear(); _mCalMonth = new Date().getMonth(); }
  else { _mCalMonth += dir; if (_mCalMonth > 11) { _mCalMonth = 0; _mCalYear++; } else if (_mCalMonth < 0) { _mCalMonth = 11; _mCalYear--; } }
  ldModalCalRender();
}

function ldModalCalRender() {
  const grid  = document.getElementById('calModalGrid');
  const title = document.getElementById('calModalMonthTitle');
  if (!grid || !title) return;
  title.textContent = new Date(_mCalYear, _mCalMonth, 1).toLocaleDateString('en-US', {month:'long', year:'numeric'});
  const firstDay = new Date(_mCalYear, _mCalMonth, 1).getDay();
  const days     = new Date(_mCalYear, _mCalMonth + 1, 0).getDate();
  const today    = new Date().toISOString().substring(0, 10);
  const evtMap   = {};
  _calEvts.forEach(e => { if (e.date) evtMap[e.date] = (evtMap[e.date] || []).concat(e); });
  let html = ['Su','Mo','Tu','We','Th','Fr','Sa'].map(d =>
    `<div style="text-align:center;font-size:10px;font-weight:700;color:var(--gray-400);padding:3px 0;">${d}</div>`
  ).join('');
  for (let i = 0; i < firstDay; i++) html += '<div></div>';
  for (let d = 1; d <= days; d++) {
    const ds   = `${_mCalYear}-${String(_mCalMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const evts = evtMap[ds] || [];
    const isT  = ds === today;
    const isPast = ds < today;
    const dots  = evts.slice(0,2).map(e =>
      `<span style="display:inline-block;width:5px;height:5px;border-radius:50%;background:${CAL_COLORS[e.type]};margin:0 1px;" title="${e.label}"></span>`
    ).join('');
    html += `<div onclick="${isPast ? '' : `ldModalDayClick('${ds}')`}"
      style="min-height:44px;padding:3px;border-radius:4px;
             background:${isT ? 'var(--green-50)' : '#fff'};
             border:1px solid ${isT ? 'var(--green-400)' : 'var(--gray-100)'};
             cursor:${isPast ? 'default' : 'pointer'};
             opacity:${isPast ? '.4' : '1'};
             transition:background .12s;"
      onmouseover="${isPast ? '' : "this.style.background='var(--green-50)'"}"
      onmouseout="${isPast ? '' : `this.style.background='${isT ? 'var(--green-50)' : '#fff'}'`}">
      <div style="font-size:11px;font-weight:${isT ? 700 : 400};color:${isT ? 'var(--green-700)' : 'var(--gray-700)'};">${d}</div>
      <div style="text-align:center;margin-top:2px;">${dots}</div>
    </div>`;
  }
  grid.innerHTML = html;
}

function ldModalDayClick(dateStr) {
  const slots = ['calModalSlot0','calModalSlot1','calModalSlot2','calModalSlot3'];
  // Fill the first empty slot; if all full, replace the last one
  let target = slots.find(id => !document.getElementById(id).value);
  if (!target) target = slots[slots.length - 1];
  document.getElementById(target).value = dateStr + 'T10:00';
  // Flash the filled input
  const el = document.getElementById(target);
  el.style.borderColor = 'var(--green-400)';
  el.style.boxShadow   = '0 0 0 3px rgba(83,109,51,.2)';
  setTimeout(() => { el.style.borderColor = ''; el.style.boxShadow = ''; }, 800);
}

function ldModalClearSlots() {
  ['calModalSlot0','calModalSlot1','calModalSlot2','calModalSlot3'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = '';
  });
}

// ── Score modal ───────────────────────────────────────────────────────────────
let _scoreLabel1 = '', _scoreLabel2 = '', _scoreP1Val = '', _scoreP2Val = '';

function ldOpenScore(lid, t1id, t2id, p1id, p2id, label1, label2, sub1, sub2) {
  document.getElementById('ldScore_t1').value = t1id;
  document.getElementById('ldScore_t2').value = t2id;
  const sel = document.getElementById('ldScore_winnerSel');
  const opt1 = sub1 ? `${label1} (${sub1})` : label1;
  const opt2 = sub2 ? `${label2} (${sub2})` : label2;
  sel.innerHTML = `<option value="">No result / walkover</option><option value="${t1id||p1id}">${opt1}</option><option value="${t2id||p2id}">${opt2}</option>`;
  document.getElementById('ldScoreForm').action = `/leagues/${lid}/pool-match`;
  document.getElementById('ldScoreMatchLabel').textContent = `${label1} vs ${label2}`;
  const playerSub = document.getElementById('ldScorePlayerSub');
  if (playerSub) {
    playerSub.textContent = (sub1 && sub2) ? `${sub1}  vs  ${sub2}` : '';
    playerSub.style.display = (sub1 && sub2) ? 'block' : 'none';
  }
  _scoreLabel1 = label1;
  _scoreLabel2 = label2;
  _scoreP1Val = String(t1id || p1id);
  _scoreP2Val = String(t2id || p2id);
  ldScoreClear();
  ldOpenModal('ldScoreModal');
}

function ldScoreValidate() {
  const input   = document.getElementById('ldScoreInput');
  const preview = document.getElementById('ldScorePreview');
  const errEl   = document.getElementById('ldScoreError');
  const hint    = document.getElementById('ldScoreWinnerHint');
  const raw = (input.value || '').trim();

  if (!raw) {
    input.style.borderColor = '';
    input.style.boxShadow   = '';
    preview.style.display = 'none';
    errEl.style.display   = 'none';
    if (hint) hint.style.display = 'none';
    return true;
  }

  const parts = raw.split(/[\s,]+/).filter(Boolean);
  const sets  = parts.map(p => { const m = p.match(/^(\d{1,2})-(\d{1,2})$/); return m ? { a:+m[1], b:+m[2] } : null; });
  const valid = sets.length > 0 && sets.every(s => s !== null);

  if (!valid) {
    input.style.borderColor = '#dc2626';
    input.style.boxShadow   = '0 0 0 3px rgba(220,38,38,.15)';
    errEl.innerHTML = '&#x26A0;&#xFE0F; Invalid format. Use <strong>X-Y</strong> per set, comma-separated — e.g. <strong>6-3, 7-5</strong>';
    errEl.style.display   = 'block';
    preview.style.display = 'none';
    if (hint) hint.style.display = 'none';
    return false;
  }

  if (sets.length > 5) {
    input.style.borderColor = '#dc2626';
    input.style.boxShadow   = '0 0 0 3px rgba(220,38,38,.15)';
    errEl.textContent     = 'Too many sets (maximum 5).';
    errEl.style.display   = 'block';
    preview.style.display = 'none';
    return false;
  }

  // Build set chips + count wins
  let winsA = 0, winsB = 0;
  const chips = sets.map(s => {
    const aWon = s.a > s.b;
    if (aWon) winsA++; else winsB++;
    return `<span style="display:inline-flex;align-items:center;gap:2px;padding:3px 9px;border-radius:6px;font-size:12px;font-weight:700;background:${aWon?'#dcfce7':'#fee2e2'};color:${aWon?'#166534':'#991b1b'};">${s.a}-${s.b}<span style="font-size:9px;margin-left:1px;">${aWon?'▲':'▼'}</span></span>`;
  });

  const l1 = _scoreLabel1 || 'Player 1';
  const l2 = _scoreLabel2 || 'Player 2';
  const leader = winsA > winsB ? l1 : winsB > winsA ? l2 : null;
  const summary = leader
    ? `<span style="font-size:11px;color:var(--green-700);font-weight:600;margin-left:2px;">→ ${leader} leads ${Math.max(winsA,winsB)}-${Math.min(winsA,winsB)}</span>`
    : `<span style="font-size:11px;color:var(--gray-400);margin-left:2px;">${winsA}-${winsB} sets each</span>`;

  preview.innerHTML = `<div style="display:flex;flex-wrap:wrap;gap:5px;align-items:center;">${chips.join('')}${summary}</div>`;
  preview.style.display = 'block';
  errEl.style.display   = 'none';
  input.style.borderColor = 'var(--green-400)';
  input.style.boxShadow   = '0 0 0 3px rgba(83,109,51,.15)';

  // Auto-suggest winner when one side clearly won
  const sel = document.getElementById('ldScore_winnerSel');
  if (sel && leader) {
    const sugVal = winsA > winsB ? _scoreP1Val : _scoreP2Val;
    if (sugVal && sel.value !== sugVal) {
      sel.value = sugVal;
      if (hint) { hint.textContent = `Auto-selected based on sets won`; hint.style.display = 'block'; }
    }
  } else if (hint) { hint.style.display = 'none'; }

  return true;
}

function ldScoreAddSet(setStr) {
  const input = document.getElementById('ldScoreInput');
  const parts = (input.value.trim()) ? input.value.trim().split(/[\s,]+/).filter(Boolean) : [];
  if (parts.length >= 5) return;
  input.value = parts.length ? parts.join(', ') + ', ' + setStr : setStr;
  ldScoreValidate();
  input.focus();
}

function ldScoreClear() {
  const input = document.getElementById('ldScoreInput');
  if (!input) return;
  input.value = '';
  input.style.borderColor = '';
  input.style.boxShadow   = '';
  const preview = document.getElementById('ldScorePreview');
  const errEl   = document.getElementById('ldScoreError');
  const hint    = document.getElementById('ldScoreWinnerHint');
  if (preview) preview.style.display = 'none';
  if (errEl)   errEl.style.display   = 'none';
  if (hint)    hint.style.display    = 'none';
}

document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('ldScoreForm');
  if (form) form.addEventListener('submit', function(e) {
    if (!ldScoreValidate()) { e.preventDefault(); }
  });
});

// ── Calendar ─────────────────────────────────────────────────────────────────
const _calEvts = <%- JSON.stringify(
  (lmatches||[]).map(m=>({
    date:(m.played_at||'').substring(0,10),
    type:'played',
    label:`${m.p1name} vs ${m.p2name} · ${m.score}`
  })).concat(
    (acceptedProposals||[]).filter(ap=>ap.scheduled_at).map(ap=>({
      date:(ap.scheduled_at||'').substring(0,10),
      type:'confirmed',
      label:`Confirmed match`
    }))
  ).concat(
    ((calProposals&&calProposals.incoming)||[]).flatMap(p=>(p.slots||[]).slice(0,1).map(s=>({
      date:(s.proposed_at||'').substring(0,10),
      type:'incoming',
      label:`Proposed by ${p.proposer_name}`
    })))
  ).concat(
    ((calProposals&&calProposals.outgoing)||[]).flatMap(p=>(p.slots||[]).slice(0,1).map(s=>({
      date:(s.proposed_at||'').substring(0,10),
      type:'outgoing',
      label:`Proposal to ${p.opponent_name}`
    })))
  )
) %>;
const CAL_COLORS = {played:'#536D33',confirmed:'#1d4ed8',incoming:'#7c3aed',outgoing:'#d97706'};
let calYear = new Date().getFullYear(), calMonth = new Date().getMonth();
function ldCalNav(dir) { if(dir===0){calYear=new Date().getFullYear();calMonth=new Date().getMonth();}else{calMonth+=dir;if(calMonth>11){calMonth=0;calYear++;}else if(calMonth<0){calMonth=11;calYear--;}} ldCalRender(); }
function ldCalRender() {
  const grid = document.getElementById('calGrid');
  const title = document.getElementById('calMonthTitle');
  if(!grid||!title) return;
  const mn = new Date(calYear,calMonth,1).toLocaleDateString('en-US',{month:'long',year:'numeric'});
  title.textContent = mn;
  const firstDay = new Date(calYear,calMonth,1).getDay();
  const days = new Date(calYear,calMonth+1,0).getDate();
  const today = new Date().toISOString().substring(0,10);
  const evtMap = {};
  _calEvts.forEach(e=>{if(e.date)evtMap[e.date]=(evtMap[e.date]||[]).concat(e);});
  let html = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=>`<div style="text-align:center;font-size:11px;font-weight:600;color:var(--gray-400);padding:4px;">${d}</div>`).join('');
  for(let i=0;i<firstDay;i++) html += '<div></div>';
  for(let d=1;d<=days;d++){
    const dateStr = `${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const evts = evtMap[dateStr]||[];
    const isToday = dateStr===today;
    const pills = evts.slice(0,3).map(e=>`<div style="font-size:10px;padding:1px 3px;border-radius:2px;background:${CAL_COLORS[e.type]};color:#fff;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${e.label}">${e.label.substring(0,18)}</div>`).join('');
    const more = evts.length>3?`<div style="font-size:10px;color:var(--gray-400);">+${evts.length-3} more</div>`:'';
    html += `<div style="min-height:60px;padding:4px;border-radius:4px;background:${isToday?'var(--green-50)':'#fff'};border:1px solid ${isToday?'var(--green-400)':'var(--gray-100)'};cursor:default;"><div style="font-size:12px;font-weight:${isToday?700:400};color:${isToday?'var(--green-700)':'var(--gray-700)'};">${d}</div>${pills}${more}</div>`;
  }
  grid.innerHTML = html;
}
</script>

