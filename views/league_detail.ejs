    <div style="padding:18px 22px;">
      <form method="POST" action="/leagues/<%= league.id %>/proposals/new" id="ldc-prop-form">
        <div class="form-group">
          <label class="form-label">Opponent <span style="color:#dc2626;">*</span></label>
