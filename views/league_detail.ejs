          <button type="button" onclick="ldcAddSlot()" id="ldc-add-slot-btn" style="margin-top:8px;width:100%;padding:8px;background:none;border:1.5px dashed var(--green-300);border-radius:7px;font-size:13px;color:var(--green-600);font-weight:500;cursor:pointer;" onmouseover="this.style.background='var(--green-50)'" onmouseout="this.style.background='none'">+ Add time slot</button>
