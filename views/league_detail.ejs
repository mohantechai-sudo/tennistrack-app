<div id="ldc-modal-prop" onclick="if(event.target===this)ldcCloseProp()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1200;align-items:center;justify-content:center;padding:16px;">
  <div onclick="event.stopPropagation()" style="background:#fff;border-radius:14px;width:100%;max-width:500px;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.25);">
    <div style="padding:18px 22px 14px;border-bottom:1px solid var(--gray-100);display:flex;justify-content:space-between;align-items:center;">
