        <% if((calProposals.incoming||[]).length===0&&(calProposals.outgoing||[]).length===0&&_futureAcc.length===0&&isMember&&league.status==='active'){ %>
        <div style="background:#fff;border-radius:10px;padding:20px;text-align:center;">
