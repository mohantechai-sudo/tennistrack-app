        <% if((calProposals.outgoing||[]).length > 0){ %>
        <div style="background:#fff;border-radius:10px;padding:14px;">
          <div style="font-weight:700;font-size:13px;color:var(--gray-800);margin-bottom:10px;">📤 Sent Proposals</div>
          <% (calProposals.outgoing||[]).forEach(p=>{ %>
