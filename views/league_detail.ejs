<script>
(function(){
  const LDC_LID = <%= league.id %>;
  const LDC_UID = <%= uid %>;
  const LDC_TODAY = new Date().toISOString().slice(0,10);
  const LDC_CAN_PROPOSE = <%= (isMember && league.status==='active') ? 'true' : 'false' %>;
  const LDC_EVENTS = <%- JSON.stringify(_calEvts).replace(/<\//g,'<\\/') %>;
  const LDC_MIN_DT = new Date().toISOString().slice(0,16);

  const dayMap = {};
  LDC_EVENTS.forEach(ev=>{ if(!ev.date)return; if(!dayMap[ev.date])dayMap[ev.date]=[]; dayMap[ev.date].push(ev); });

  const todayObj = new Date();
  let curY = todayObj.getFullYear(), curM = todayObj.getMonth();
  const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];

  function ldcRender() {
    const grid = document.getElementById('ldc-grid');
    if(!grid) return;
    grid.innerHTML = '';
    document.getElementById('ldc-month-lbl').textContent = MONTHS[curM];
    document.getElementById('ldc-year-lbl').textContent = curY;
    const first = new Date(curY, curM, 1);
    let startDow = first.getDay()-1; if(startDow<0) startDow=6;
    const dim = new Date(curY, curM+1, 0).getDate();
    const prevDim = new Date(curY, curM, 0).getDate();
    const total = Math.ceil((startDow+dim)/7)*7;
    for(let i=0;i<total;i++){
      const cell = document.createElement('div');
      cell.className = 'ldc-cell';
      let dayNum, dateStr, inMonth=true;
      if(i<startDow){ dayNum=prevDim-startDow+i+1; dateStr=new Date(curY,curM-1,dayNum).toISOString().slice(0,10); inMonth=false; }
      else if(i-startDow<dim){ dayNum=i-startDow+1; dateStr=new Date(curY,curM,dayNum).toISOString().slice(0,10); }
      else{ dayNum=i-startDow-dim+1; dateStr=new Date(curY,curM+1,dayNum).toISOString().slice(0,10); inMonth=false; }
      const isToday=dateStr===LDC_TODAY, isPast=dateStr<LDC_TODAY;
      cell.style.background=inMonth?'#fff':'#fafafa';
      const numEl=document.createElement('div'); numEl.className='ldc-day-num'; numEl.textContent=dayNum;
      numEl.style.color=inMonth?(isPast?'var(--gray-400)':'var(--gray-800)'):'var(--gray-200)';
      if(isToday){numEl.style.background='var(--green-500)';numEl.style.color='#fff';}
      cell.appendChild(numEl);
      const evs=(dayMap[dateStr]||[]).slice().sort((a,b)=>(a.time||'').localeCompare(b.time||''));
      const maxV=3;
      evs.slice(0,maxV).forEach(ev=>{
        const pill=document.createElement('div'); pill.className='ldc-pill';
        pill.style.background=ev.color+'22'; pill.style.color=ev.color; pill.style.border='1px solid '+ev.color+'44';
        pill.textContent=(ev.time?ev.time+' ':'')+ev.label;
        pill.onclick=()=>ldcOpenEvt(ev.id); cell.appendChild(pill);
      });
      if(evs.length>maxV){ const m=document.createElement('div'); m.style.cssText='font-size:10px;color:var(--gray-400);padding:1px 4px;cursor:pointer;'; m.textContent='+'+(evs.length-maxV)+' more'; m.onclick=()=>ldcOpenDay(dateStr,evs); cell.appendChild(m); }
      if(LDC_CAN_PROPOSE&&inMonth&&!isPast){
        const ab=document.createElement('button'); ab.className='ldc-add-btn';
        ab.style.cssText='position:absolute;top:4px;right:4px;width:18px;height:18px;border-radius:50%;background:var(--green-500);border:none;color:#fff;font-size:12px;cursor:pointer;opacity:0;transition:.15s;display:flex;align-items:center;justify-content:center;padding:0;';
        ab.textContent='+'; ab.title='Propose match';
        ab.onclick=(e)=>{e.stopPropagation();ldcOpenProposal(dateStr);}; cell.appendChild(ab);
      }
      grid.appendChild(cell);
    }
  }

  window.ldcNav=function(d){curM+=d;if(curM>11){curM=0;curY++;}else if(curM<0){curM=11;curY--;}ldcRender();};
  window.ldcToday=function(){curY=todayObj.getFullYear();curM=todayObj.getMonth();ldcRender();};

  function ldcFmtDT(dt){ if(!dt)return''; try{const d=new Date(dt.length<=10?dt+'T12:00:00':dt);return d.toLocaleString('en-US',{weekday:'short',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});}catch(e){return dt;} }

  window.ldcOpenEvt=function(evId){
    const ev=LDC_EVENTS.find(e=>e.id===evId); if(!ev)return;
    const typeLabel={match:'Match',scheduled:'Confirmed',incoming:'Incoming Proposal',outgoing:'Sent Proposal'};
    document.getElementById('ldc-evt-title').textContent=(typeLabel[ev.type]||'Event')+' — '+(ev.date?new Date(ev.date+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric'}):'');
    const ir=(icon,text)=>text?`<div style="display:flex;gap:8px;align-items:center;font-size:13px;color:var(--gray-600);margin-bottom:6px;"><span>${icon}</span><span>${text}</span></div>`:'';
    let html='';
    if(ev.type==='match'){
      html+=`<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;"><span style="width:9px;height:9px;border-radius:50%;background:#536D33;"></span><span style="font-size:11px;font-weight:700;color:#536D33;text-transform:uppercase;">Played Match</span></div>`;
      html+=ir('🆚',`${ev.p1name}${ev.p1partner?' & '+ev.p1partner:''} vs ${ev.p2name}${ev.p2partner?' & '+ev.p2partner:''}`);
      html+=ir('📅',ldcFmtDT(ev.date+(ev.time?'T'+ev.time:'')));
      if(ev.score)html+=ir('🏆',ev.score); html+=ir('🎾',ev.surface); if(ev.venue)html+=ir('📍',ev.venue);
      if(ev.myWin!==undefined)html+=`<div style="margin-top:10px;padding:8px 12px;border-radius:8px;font-weight:600;font-size:13px;background:${ev.myWin?'var(--green-50)':'#fef2f2'};color:${ev.myWin?'var(--green-700)':'#dc2626'};">${ev.myWin?'✅ You won':'❌ You lost'}</div>`;
    } else if(ev.type==='scheduled'){
      html+=`<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;"><span style="width:9px;height:9px;border-radius:50%;background:#1d4ed8;"></span><span style="font-size:11px;font-weight:700;color:#1d4ed8;text-transform:uppercase;">Confirmed Match</span></div>`;
      html+=ir('🆚','vs '+ev.oppName); html+=ir('📅',ldcFmtDT(ev.date+(ev.time?'T'+ev.time:''))); html+=ir('🎾',ev.surface); if(ev.venue)html+=ir('📍',ev.venue);
      if(ev.iAmProposer)html+=`<div style="margin-top:14px;"><form method="POST" action="/leagues/${LDC_LID}/proposals/${ev.proposalId}/cancel" style="display:flex;gap:8px;"><input type="hidden" name="reschedule" value="1"/><button type="submit" class="btn btn-outline btn-sm" style="flex:1;" onclick="return confirm('Cancel and reschedule?')">🔄 Reschedule</button><button type="submit" name="reschedule" value="0" class="btn btn-outline btn-sm" style="color:#dc2626;border-color:#fecaca;" onclick="return confirm('Cancel this match?')">Cancel</button></form></div>`;
    } else if(ev.type==='incoming'){
      html+=`<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;"><span style="width:9px;height:9px;border-radius:50%;background:#7c3aed;"></span><span style="font-size:11px;font-weight:700;color:#7c3aed;text-transform:uppercase;">Proposal — Choose Slot</span></div>`;
      html+=ir('👤','From: '+ev.oppName); html+=ir('🎾',ev.surface); if(ev.venue)html+=ir('📍',ev.venue);
      if(ev.notes)html+=`<div style="font-size:12px;color:var(--gray-500);background:var(--gray-50);border-radius:6px;padding:8px;margin:8px 0;">${ev.notes}</div>`;
      html+=`<div style="font-size:11px;font-weight:600;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;margin:10px 0 6px;">Proposed times:</div><div style="display:flex;flex-direction:column;gap:5px;">`;
      ev.allSlots.forEach(s=>{html+=`<form method="POST" action="/leagues/${LDC_LID}/proposals/${ev.proposalId}/accept"><input type="hidden" name="slot_id" value="${s.id}"><button type="submit" style="width:100%;text-align:left;padding:9px 12px;border:1.5px solid var(--gray-200);border-radius:7px;background:#fff;cursor:pointer;font-size:12px;display:flex;justify-content:space-between;" onmouseover="this.style.borderColor='#7c3aed';this.style.background='#f5f3ff'" onmouseout="this.style.borderColor='var(--gray-200)';this.style.background='#fff'"><span style="font-weight:500;">📅 ${ldcFmtDT(s.dt)}</span><span style="font-size:11px;color:#7c3aed;font-weight:700;">Accept ✓</span></button></form>`;});
      html+=`</div><form method="POST" action="/leagues/${LDC_LID}/proposals/${ev.proposalId}/decline" style="margin-top:8px;"><button type="submit" style="width:100%;padding:7px;background:none;border:1px solid #fecaca;border-radius:6px;color:#dc2626;font-size:12px;cursor:pointer;font-weight:500;" onclick="return confirm('Decline?')">✕ Decline all</button></form>`;
    } else if(ev.type==='outgoing'){
      html+=`<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;"><span style="width:9px;height:9px;border-radius:50%;background:#d97706;"></span><span style="font-size:11px;font-weight:700;color:#d97706;text-transform:uppercase;">Sent Proposal</span></div>`;
      html+=ir('👤','To: '+ev.oppName); html+=ir('🎾',ev.surface); if(ev.venue)html+=ir('📍',ev.venue);
      ev.allSlots.forEach(s=>{html+=`<div style="font-size:12px;color:var(--gray-700);padding:5px 9px;border:1px solid var(--gray-200);border-radius:5px;margin-bottom:3px;">📅 ${ldcFmtDT(s.dt)}</div>`;});
      html+=`<form method="POST" action="/leagues/${LDC_LID}/proposals/${ev.proposalId}/cancel" style="margin-top:10px;"><button type="submit" style="width:100%;padding:7px;background:none;border:1px solid #fecaca;border-radius:6px;color:#dc2626;font-size:12px;cursor:pointer;font-weight:500;" onclick="return confirm('Withdraw?')">✕ Withdraw</button></form>`;
    }
    document.getElementById('ldc-evt-body').innerHTML=html;
    document.getElementById('ldc-modal-event').style.display='flex';
  };

  window.ldcOpenDay=function(dateStr,evs){
    document.getElementById('ldc-evt-title').textContent='📅 '+new Date(dateStr+'T12:00:00').toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric'});
    let html='<div style="display:flex;flex-direction:column;gap:7px;">';
    evs.forEach(ev=>{html+=`<button onclick="ldcCloseEvt();setTimeout(()=>ldcOpenEvt('${ev.id}'),80)" style="text-align:left;padding:9px 12px;border:1.5px solid ${ev.color}33;border-radius:7px;background:${ev.color}11;cursor:pointer;font-size:13px;color:${ev.color};font-weight:500;">${(ev.time?ev.time+' ':'')}${ev.label}</button>`;});
    html+='</div>';
    document.getElementById('ldc-evt-body').innerHTML=html;
    document.getElementById('ldc-modal-event').style.display='flex';
  };

  let ldcSlotCount=0;
  window.ldcOpenProposal=function(prefillDate, proposeOpp){
    ldcSlotCount=0;
    document.getElementById('ldc-slots').innerHTML='';
    document.getElementById('ldc-add-slot-btn').style.display='block';
    const oppSel=document.getElementById('ldc-prop-opp');
    if(oppSel){ oppSel.value = proposeOpp||''; }
    ldcAddSlot(prefillDate);
    document.getElementById('ldc-modal-prop').style.display='flex';
  };
  window.ldcAddSlot=function(prefillDate){
    if(ldcSlotCount>=4)return; ldcSlotCount++;
    const list=document.getElementById('ldc-slots');
    const row=document.createElement('div'); row.style.cssText='display:flex;align-items:center;gap:8px;';
    const inp=document.createElement('input'); inp.type='datetime-local'; inp.name='slots'; inp.min=LDC_MIN_DT; inp.className='form-input'; inp.style.flex='1'; inp.required=true;
    if(prefillDate) inp.value=prefillDate+'T10:00';
    const rm=document.createElement('button'); rm.type='button'; rm.textContent='✕'; rm.style.cssText='background:none;border:none;color:var(--gray-400);cursor:pointer;font-size:16px;padding:4px;flex-shrink:0;';
    rm.onclick=()=>{row.remove();ldcSlotCount--;document.getElementById('ldc-add-slot-btn').style.display=ldcSlotCount>=4?'none':'block';};
    row.appendChild(inp); row.appendChild(rm); list.appendChild(row);
    document.getElementById('ldc-add-slot-btn').style.display=ldcSlotCount>=4?'none':'block';
    inp.focus();
  };
  window.ldcValidate=function(){
    const slots=document.querySelectorAll('#ldc-slots input[name="slots"]');
    if(!document.getElementById('ldc-prop-opp').value){alert('Please select an opponent.');return false;}
    if(slots.length===0){alert('Add at least one time slot.');return false;}
    return true;
  };
  window.ldcClose=function(){document.getElementById('ldc-backdrop').style.display='none';};
  window.ldcCloseEvt=function(){document.getElementById('ldc-modal-event').style.display='none';};
  window.ldcCloseProp=function(){const m=document.getElementById('ldc-modal-prop');if(m)m.style.display='none';};
  window.openCalendarModal=function(proposeOpp){
    document.getElementById('ldc-backdrop').style.display='flex';
    ldcRender();
    if(proposeOpp&&LDC_CAN_PROPOSE) setTimeout(()=>ldcOpenProposal(null,proposeOpp),150);
  };

  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'){
      if(document.getElementById('ldc-modal-prop')&&document.getElementById('ldc-modal-prop').style.display==='flex'){ldcCloseProp();return;}
      if(document.getElementById('ldc-modal-event').style.display==='flex'){ldcCloseEvt();return;}
      if(document.getElementById('ldc-backdrop').style.display==='flex'){ldcClose();return;}
    }
  });
})();
</script>

<!-- ── Fixtures Modal ──────────────────────────────────────────────────── -->
<%
  function _genPairs(arr){const p=[];for(let i=0;i<arr.length;i++)for(let j=i+1;j<arr.length;j++)p.push([arr[i],arr[j]]);return p;}
  function _playedD(t1,t2){return(lmatches||[]).find(m=>(m.player1_id===t1.player1_id&&m.player2_id===t2.player1_id)||(m.player1_id===t2.player1_id&&m.player2_id===t1.player1_id));}
  function _schedD(t1,t2){return(acceptedProposals||[]).find(p=>(p.proposer_id===t1.player1_id&&p.opponent_id===t2.player1_id)||(p.proposer_id===t2.player1_id&&p.opponent_id===t1.player1_id));}
  function _playedS(p1,p2){return(lmatches||[]).find(m=>(m.player1_id===p1.id&&m.player2_id===p2.id)||(m.player1_id===p2.id&&m.player2_id===p1.id));}
  function _schedS(p1,p2){return(acceptedProposals||[]).find(p=>(p.proposer_id===p1.id&&p.opponent_id===p2.id)||(p.proposer_id===p2.id&&p.opponent_id===p1.id));}
  function _fxFmt(d){try{return new Date(d).toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});}catch(e){return d;}}
%>
<div id="modal-fixtures" onclick="if(event.target===this)this.style.display='none'" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:1100;align-items:flex-start;justify-content:center;padding:16px;overflow-y:auto;">
  <div onclick="event.stopPropagation()" style="background:#fff;border-radius:16px;width:100%;max-width:880px;margin:auto;box-shadow:0 24px 80px rgba(0,0,0,.3);overflow:hidden;">

    <!-- Header -->
    <div style="display:flex;justify-content:space-between;align-items:center;padding:18px 24px;border-bottom:1px solid var(--gray-100);position:sticky;top:0;background:#fff;z-index:10;">
      <div>
        <div style="font-size:17px;font-weight:700;color:var(--gray-800);">📋 League Fixtures</div>
        <div style="font-size:12px;color:var(--gray-400);margin-top:2px;"><%= league.name %> · <%= league.format==='round_robin'?'Round Robin':'Knockout' %></div>
      </div>
      <button onclick="document.getElementById('modal-fixtures').style.display='none'" style="background:none;border:none;cursor:pointer;font-size:22px;color:var(--gray-400);line-height:1;padding:2px 8px;">✕</button>
    </div>

    <!-- Per-pool fixture tables -->
    <div style="padding:20px 24px;display:flex;flex-direction:column;gap:24px;max-height:82vh;overflow-y:auto;">
    <% _pools.forEach(pool=>{ %>
    <%
      const _fxMids = new Set(pool.poolMembers.map(m=>m.id));
      const _fxTeams = isDoublesCat ? (teams||[]).filter(t=>_fxMids.has(t.player1_id)&&_fxMids.has(t.player2_id)) : [];
      const _fxSolo  = !isDoublesCat ? pool.poolMembers : [];
      const _fxPairs = isDoublesCat ? _genPairs(_fxTeams) : _genPairs(_fxSolo);
      const _played  = isDoublesCat ? _fxPairs.filter(([a,b])=>_playedD(a,b)).length : _fxPairs.filter(([a,b])=>_playedS(a,b)).length;
    %>
    <div>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;padding-bottom:10px;border-bottom:3px solid <%= pool.color %>;">
        <div style="width:12px;height:12px;border-radius:3px;background:<%= pool.color %>;flex-shrink:0;"></div>
        <span style="font-size:15px;font-weight:700;color:var(--gray-800);"><%= pool.name %></span>
        <span style="font-size:12px;color:var(--gray-400);"><%= _fxPairs.length %> fixture<%= _fxPairs.length!==1?'s':'' %></span>
        <span style="font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--green-50);color:var(--green-700);"><%= _played %> played</span>
        <span style="font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:#f0f9ff;color:#0369a1;"><%= _fxPairs.length-_played %> remaining</span>
      </div>

      <% if(_fxPairs.length===0){ %>
      <div style="text-align:center;padding:24px;color:var(--gray-400);font-size:13px;font-style:italic;">No teams assigned to this pool.</div>
      <% } else { %>
      <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:13px;">
        <thead>
          <tr style="border-bottom:2px solid var(--gray-100);">
            <th style="text-align:left;padding:8px 10px;font-size:11px;font-weight:600;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;width:32px;">#</th>
            <th style="text-align:left;padding:8px 10px;font-size:11px;font-weight:600;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;">Match</th>
            <th style="text-align:left;padding:8px 10px;font-size:11px;font-weight:600;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;width:140px;">Venue</th>
            <th style="text-align:center;padding:8px 10px;font-size:11px;font-weight:600;color:var(--gray-400);text-transform:uppercase;letter-spacing:.05em;width:120px;">Actions</th>
          </tr>
        </thead>
        <tbody>
        <% _fxPairs.forEach(([a,b],pi)=>{ %>
        <%
          const _fxPlayed = isDoublesCat ? _playedD(a,b) : _playedS(a,b);
          const _fxSched  = isDoublesCat ? _schedD(a,b)  : _schedS(a,b);
          const _fxVenue  = (_fxPlayed&&_fxPlayed.venue) ? _fxPlayed.venue : ((_fxSched&&_fxSched.venue) ? _fxSched.venue : null);
          const _aLabel = isDoublesCat ? ((a.p1full||a.p1name)+' / '+(a.p2full||a.p2name)) : (a.full_name||a.username);
          const _bLabel = isDoublesCat ? ((b.p1full||b.p1name)+' / '+(b.p2full||b.p2name)) : (b.full_name||b.username);
          const _aSub   = isDoublesCat ? (a.name||'') : '';
          const _bSub   = isDoublesCat ? (b.name||'') : '';
          const _pairTeamsJson = isDoublesCat ? JSON.stringify([a,b].map(t=>({id:t.id,name:t.name,color:t.color,p1name:t.p1full||t.p1name,p2name:t.p2full||t.p2name}))) : '[]';
          const _calOppId = isDoublesCat ? b.player1_id : b.id;
        %>
        <tr style="border-bottom:1px solid var(--gray-100);" onmouseover="this.style.background='var(--gray-50)'" onmouseout="this.style.background=''">
          <!-- # -->
          <td style="padding:13px 10px;font-weight:700;color:var(--gray-300);font-size:12px;"><%= pi+1 %></td>

          <!-- Match -->
          <td style="padding:13px 10px;">
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
              <div>
                <div style="font-weight:600;color:var(--gray-800);"><%= _aLabel %></div>
                <% if(_aSub){ %><div style="font-size:11px;color:var(--gray-400);"><%- _aSub %></div><% } %>
              </div>
              <span style="font-size:11px;font-weight:700;color:var(--gray-400);padding:2px 7px;background:var(--gray-100);border-radius:4px;flex-shrink:0;">VS</span>
              <div>
                <div style="font-weight:600;color:var(--gray-800);"><%= _bLabel %></div>
                <% if(_bSub){ %><div style="font-size:11px;color:var(--gray-400);"><%- _bSub %></div><% } %>
              </div>
              <!-- Status badge -->
              <% if(_fxPlayed){ %>
              <span style="font-size:11px;font-weight:600;padding:3px 8px;border-radius:999px;background:var(--green-50);color:var(--green-700);white-space:nowrap;flex-shrink:0;">✅ <%= _fxPlayed.score||'Played' %></span>
              <% } else if(_fxSched){ %>
              <span style="font-size:11px;font-weight:600;padding:3px 8px;border-radius:999px;background:#eff6ff;color:#1d4ed8;white-space:nowrap;flex-shrink:0;">📅 <%= _fxFmt(_fxSched.scheduled_at) %></span>
              <% } %>
            </div>
          </td>

          <!-- Venue -->
          <td style="padding:13px 10px;">
            <span style="font-size:12px;color:<%= _fxVenue?'var(--gray-700)':'var(--gray-300)' %>;">
              📍 <%= _fxVenue||'TBD' %>
            </span>
          </td>

          <!-- Actions -->
          <td style="padding:13px 10px;text-align:center;">
            <% if(_fxPlayed){ %>
            <span style="font-size:11px;color:var(--green-600);font-weight:600;">Completed</span>
            <% } else { %>
            <div style="display:inline-flex;gap:6px;align-items:center;">
              <!-- 📅 Schedule / calendar -->
              <button type="button" title="Schedule match"
                onclick="document.getElementById('modal-fixtures').style.display='none';openCalendarModal('<%= _calOppId %>')"
                style="width:32px;height:32px;border-radius:7px;background:var(--gray-50);border:1.5px solid var(--gray-200);cursor:pointer;font-size:15px;display:inline-flex;align-items:center;justify-content:center;transition:.15s;"
                onmouseover="this.style.borderColor='#93c5fd';this.style.background='#eff6ff'"
                onmouseout="this.style.borderColor='var(--gray-200)';this.style.background='var(--gray-50)'">📅</button>
              <!-- 🏆 Report score (creator only) -->
              <% if(isCreator && isDoublesCat){ %>
              <button type="button" title="Report score"
                data-pool="<%= pool.id %>"
                data-teams='<%- _pairTeamsJson %>'
                data-pre="<%= a.id %>"
                onclick="document.getElementById('modal-fixtures').style.display='none';openScoreModal(this)"
                style="width:32px;height:32px;border-radius:7px;background:var(--gray-50);border:1.5px solid var(--gray-200);cursor:pointer;font-size:15px;display:inline-flex;align-items:center;justify-content:center;transition:.15s;"
                onmouseover="this.style.borderColor='var(--green-400)';this.style.background='var(--green-50)'"
                onmouseout="this.style.borderColor='var(--gray-200)';this.style.background='var(--gray-50)'">🏆</button>
              <% } %>
            </div>
            <% } %>
          </td>
        </tr>
        <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </div>
    <% }) %>
    </div><!-- /body -->
  </div>
</div>
<script>
document.addEventListener('keydown',function(e){if(e.key==='Escape'){const m=document.getElementById('modal-fixtures');if(m&&m.style.display==='flex')m.style.display='none';}});
</script>

<%- include('layout_bottom') %>
